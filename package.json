{
  "name": "yzgundemi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "YZ Gündemi (yzgundemi.com) — Türkçe yapay zeka haber sitesi. Astro + Claude API ile günde 2 kez otomatik güncellenir.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/brand-css.mjs",
    "build": "astro build && pagefind --site dist --silent",
    "preview": "astro preview",
    "news": "node scripts/generate-news.mjs",
    "news:dry": "node scripts/generate-news.mjs --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "pagefind": "1.6.0",
    "playwright-core": "1.65.1",
    "sharp": "0.35.5"
  }
}
