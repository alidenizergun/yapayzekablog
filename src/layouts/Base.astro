---
// Yazı tipleri sitenin kendi sunucusundan verilir (Google'a ziyaretçi IP'si gitmez, KVKK; CSP daha sıkı)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/schibsted-grotesk/800.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import { SITE, NAV, CATEGORIES, categoryBySlug } from '../lib/site.js';
import { getNews, newsUrl, catUrl, url, slugOf } from '../lib/news.js';
import { i18n, locNewsList, OG_LOCALE, SITE_DESC_EN } from '../i18n/index.js';
import { getCollection } from 'astro:content';
import { SECTORS } from '../lib/sectors.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  currentCat?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  // Haber sayfaları için: yayın tarihi, kategori ve etiketler (article:* meta etiketleri)
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
  // Konum (breadcrumb) şeması: [{ name, path }]
  breadcrumbs?: { name: string; path: string }[];
}
const L = await i18n(Astro);
const { lang, T, alternates, S } = L;
const SITE_TITLE = T(SITE.title, 'YZ Gündemi · AI News from Turkey and the World');
const SITE_DESC = T(SITE.description, SITE_DESC_EN);
const { title, description: rawDescription = SITE_DESC, ogImage, ogType = 'website', currentCat, jsonLd, noindex = false, article, breadcrumbs } = Astro.props;
// Başlık: "Haber başlığı · YZ Gündemi"; çok uzun başlıklarda (70+) marka eki atılır, arama sonucunda kesilmesin
const fullTitle = title ? (`${title} · ${SITE.name}`.length > 70 ? title : `${title} · ${SITE.name}`) : SITE_TITLE;
// Açıklama en fazla 160 karakter, kelime ortasında kesilmez
const description = rawDescription.length > 160 ? rawDescription.slice(0, 157).replace(/[\s,;:.]+\S*$/, '') + '…' : rawDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const allNews = locNewsList(await getNews(), lang, L.m);
const latest = allNews[0];
// Son dakika şeridi: en yeni 5 haber, 3 saniyede bir sırayla gösterilir
const tickerNews = allNews.slice(0, 5);
const og = new URL(ogImage ?? url('/og/site.png'), Astro.site).href;
const abs = (p: string) => new URL(url(p), Astro.site).href;
// Site geneli yapılandırılmış veri: yayın kuruluşu + web sitesi; sayfa şemaları bunlara @id ile bağlanır
const ORG_ID = abs('/#organization');
const siteLd: object[] = [
  {
    '@type': 'NewsMediaOrganization',
    '@id': ORG_ID,
    name: SITE.name,
    url: abs('/'),
    logo: { '@type': 'ImageObject', url: abs('/logo.png'), width: 512, height: 512 },
    description: SITE_DESC,
    ethicsPolicy: abs('/hakkimizda/'),
    verificationFactCheckingPolicy: abs('/hakkimizda/'),
    unnamedSourcesPolicy: abs('/hakkimizda/'),
    noBylinesPolicy: `${abs('/hakkimizda/')}#imza`,
    actionableFeedbackPolicy: abs('/hata-bildir/'),
    ownershipFundingInfo: abs('/kunye/'),
    foundingDate: '2026-11',
    areaServed: { '@type': 'Country', name: 'Türkiye' },
    knowsAbout: ['Yapay zeka', 'Artificial intelligence', 'Büyük dil modelleri', 'Yapay zeka girişimleri', 'Yapay zeka regülasyonu'],
    correctionsPolicy: abs('/duzeltmeler/'),
    masthead: abs('/kunye/'),
    publishingPrinciples: abs('/hakkimizda/'),
    sameAs: [
      SITE.social?.x && `https://x.com/${SITE.social.x}`,
      SITE.social?.instagram && `https://www.instagram.com/${SITE.social.instagram}/`,
      SITE.social?.linkedin && `https://www.linkedin.com/company/${SITE.social.linkedin}/`,
    ].filter(Boolean),
  },
  { '@type': 'WebSite', '@id': abs('/#website'), name: SITE.name, url: abs('/'), inLanguage: ['tr-TR', 'en-US'], publisher: { '@id': ORG_ID } },
];
if (breadcrumbs?.length) {
  siteLd.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: i === 0 ? T(b.name, 'Home') : b.name, item: abs(L.u(b.path)) })),
  });
}
const pageLd = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((j: any) => { const { ['@context']: _c, ...rest } = j; return rest; });
const ldGraph = { '@context': 'https://schema.org', '@graph': [...siteLd, ...pageLd] };
const ogTitle = title ?? SITE_TITLE;
// Dil karşılıkları (hreflang): iki dilde de sayfa varsa
const altTr = alternates.tr && abs(alternates.tr), altEn = alternates.en && abs(alternates.en);
const switchHref = url(lang === 'en' ? (alternates.tr ?? '/') : (alternates.en ?? '/en/'));
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// Menüde yalnızca haberi olan kategoriler görünür
const counts = new Map();
for (const n of allNews) counts.set(n.data.category, (counts.get(n.data.category) ?? 0) + 1);
// Menü: önce NAV sırası, ardından haberi olan diğer kategoriler; haberi olmayan kategori gösterilmez
const nav = [...NAV, ...CATEGORIES.map((c) => c.slug).filter((s) => !NAV.includes(s))].filter((slug) => counts.get(slug));
// Gruplu menü: Haberler (kategoriler) · Araç rehberi · Öğren · Türkiye · Takip
const path = Astro.url.pathname;
const item = (label, href, desc = '') => ({ label, href: L.u(href), desc, current: href === '/' ? isHome : path.startsWith(L.u(href)) });
// İş kolları menüsü yalnızca rehberi olan sektörleri gösterir
const sectorSet = new Set((await getCollection('rehberler', (g) => !g.data.draft && g.data.sector)).map((g) => g.data.sector));
const liveSectors = SECTORS.filter((s) => sectorSet.has(s.slug));
const navGroups = [
  { label: T('Haberler', 'News'), cols: true, items: nav.map((slug) => ({ ...item(S(`cat.${slug}.name`, categoryBySlug(slug)?.name), `/kategori/${slug}/`), current: slug === currentCat })) },
  { label: T('Araç rehberi', 'AI tools'), items: [
    item(T('Yapay zeka araçları', 'AI tools directory'), '/arac/', T('Fiyatlar, ücretsiz planlar, alternatifler', 'Pricing, free plans, alternatives')),
    item(T('Araç seçici', 'Tool finder'), '/arac-secici/', T('Size uygun aracı bulun', 'Find the right tool for you')),
    item(T('İşe göre en iyiler', 'Best tools by task'), '/en-iyi/', T('CV, görsel, video, kod ve daha fazlası', 'Resumes, images, video, code and more')),
    item(T('Karşılaştırmalar', 'Comparisons'), '/karsilastir/', T('ChatGPT mi Claude mi?', 'ChatGPT or Claude?')),
    item(T('Ücretsiz araçlar', 'Free AI tools'), '/ucretsiz-yapay-zeka-araclari/'),
    item(T('Yeni araçlar', 'New AI tools'), '/yeni-araclar/'),
    item(T('Model API fiyatları', 'AI model API pricing'), '/modeller-karsilastirma/'),
  ] },
  { label: T('Öğren', 'Learn'), items: [
    item(T('Rehberler', 'Guides'), '/rehber/', T('Adım adım kullanım kılavuzları', 'Step-by-step how-to guides')),
    item(T('Sözlük', 'Glossary'), '/sozluk/', T('Yapay zeka terimleri sade Türkçeyle', 'AI terms in plain English')),
    item(T('Raporlar', 'Reports'), '/raporlar/', T('McKinsey, Stanford, PwC raporlarından öne çıkanlar', 'Key findings from major AI reports')),
    item(T('Yapay zeka nedir?', 'What is AI?'), '/sozluk/yapay-zeka/'),
  ] },
  ...(liveSectors.length ? [{ label: T('Sektörler', 'Industries'), items: [
    item(T('Tüm iş kolları', 'All industries'), '/sektor/', T('Her sektör için rehberler, araçlar ve haberler', 'Guides, tools and news for each industry')),
    ...liveSectors.map((s) => item(T(s.title, s.en.title), `/sektor/${s.slug}/`)),
  ] }] : []),
  { label: T('Türkiye', 'Turkey'), items: [
    item(T("Türkiye'de yapay zeka", 'AI in Turkey'), '/turkiye-yapay-zeka/', T('Ekosistem, düzenlemeler, yatırımlar', 'Ecosystem, regulation, funding')),
    item(T('Yerli modeller', 'Turkish AI models'), '/yerli-yapay-zeka/'),
    ...(counts.get('turkiye') ? [item(T('Türkiye haberleri', 'Turkey news'), '/kategori/turkiye/')] : []),
    item(T('Etkinlik takvimi', 'Events'), '/etkinlikler/'),
  ] },
  { label: T('Takip', 'Trackers'), right: true, items: [
    item(T('Haftalık özet', 'Weekly roundup'), '/haftalik/', T('Haftanın en önemli gelişmeleri', 'The week’s biggest stories')),
    item(T('Gelişen hikâyeler', 'Developing stories'), '/gelisme/', T('Süren olayların zaman çizelgesi', 'Timelines of ongoing stories')),
    item(T('Yatırım takipçisi', 'Funding tracker'), '/yatirimlar/'),
    item(T('Şirketler ve kişiler', 'Companies and people'), '/konular/'),
  ] },
];
const isHome = Astro.url.pathname.replace(/\/$/, '') === L.u('/').replace(/\/$/, '');
const footerCats = CATEGORIES.filter((c) => counts.get(c.slug));
const year = new Intl.DateTimeFormat(L.locale, { year: 'numeric', timeZone: SITE.timeZone }).format(new Date());
// Bülten formu yalnızca bir bülten servisi bağlıysa gösterilir
const newsletterOn = Boolean(import.meta.env.PUBLIC_NEWSLETTER_ACTION);
// "Son dakika" yalnızca son 6 saatteki haber için; sayfadaki betik ziyaret anına göre günceller
const BREAKING_MS = 6 * 3600e3;
const isBreaking = latest && Date.now() - latest.data.date.valueOf() < BREAKING_MS;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <meta name="robots" content={robots} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={L.u('/rss.xml')} />
  {altTr && altEn && <link rel="alternate" hreflang="tr" href={altTr} />}
  {altTr && altEn && <link rel="alternate" hreflang="en" href={altEn} />}
  {altTr && altEn && <link rel="alternate" hreflang="x-default" href={altTr} />}
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <link rel="stylesheet" href={url('/marka-renkleri.css')} />
  <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
  <link rel="icon" href={url('/favicon-96.png')} sizes="96x96" type="image/png" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="manifest" href={url('/site.webmanifest')} />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <!-- Haber fotoğrafları (en büyük görsel, LCP) için bağlantıyı erkenden kur -->
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {altTr && altEn && <meta property="og:locale:alternate" content={OG_LOCALE[lang === 'en' ? 'tr' : 'en']} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  {SITE.social?.x && <meta name="twitter:site" content={`@${SITE.social.x}`} />}
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
  {SITE.analytics?.ga4 && (
    <>
      {/* Google Analytics 4 + Consent Mode v2: her ziyaretçide yüklenir; izin verilmeden çerez yazmaz,
          yalnızca çerezsiz anonim sinyal gönderir (Google bu ziyaretleri modelleyerek raporlara ekler). */}
      <script is:inline define:vars={{ GA: SITE.analytics.ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        var izin = null;
        try { izin = localStorage.getItem('yz-cerez-izni'); } catch (e) {}
        gtag('consent', 'default', {
          analytics_storage: izin === 'granted' ? 'granted' : 'denied',
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          wait_for_update: 500
        });
        gtag('js', new Date());
        gtag('config', GA, { allow_google_signals: false, allow_ad_personalization_signals: false });
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.ga4}`}></script>
    </>
  )}
  <script is:inline>
    // Sayfa çizilmeden önce kayıtlı temayı uygula (beyaz yanıp sönmeyi önler)
    try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
    // Çerçeveleme koruması: site başka bir sitenin çerçevesinde açılırsa içerik gizlenir ve kendi penceresine taşınmaya çalışılır
    // (GitHub Pages frame-ancestors / X-Frame-Options başlığı ayarlatmadığı için)
    if (window.top !== window.self) { document.documentElement.style.visibility = 'hidden'; try { window.top.location.replace(window.self.location.href); } catch (e) {} }
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
</head>
<body>
  <a class="skip-link" href="#icerik">{T('İçeriğe geç', 'Skip to content')}</a>
  <aside class="ticker" aria-label={T('Son haber', 'Latest story')}><div class="wrap">
    {latest ? (
      <>
        <span class="badge" data-breaking={latest.data.date.toISOString()}>{isBreaking ? T('Son dakika', 'Breaking') : T('Son haber', 'Latest')}</span>
        <div class="tick-items" data-ticker aria-live="off">
          {tickerNews.map((n, i) => (
            <a href={L.u(`/haber/${slugOf(n)}/`)} data-date={n.data.date.toISOString()} hidden={i > 0 ? true : undefined}>{n.data.title}</a>
          ))}
        </div>
      </>
    ) : <span>{T('Yeni haberler yakında.', 'News coming soon.')}</span>}
  </div></aside>

  <header class="site">
    <div class="wrap masthead">
      <a class="logo" href={L.u('/')} aria-label={T('YZ Gündemi ana sayfa', 'YZ Gündemi home')}>
        <span class="wm" aria-hidden="true"><span class="wm-badge">YZ</span><span class="wm-text"><span class="wm-sub">{T('YAPAY ZEKA', 'AI NEWS')}</span><span class="wm-main">Gündemi</span></span></span>
      </a>
      {newsletterOn && <div class="head-actions"><a class="btn btn-newsletter" href="#bulten">{T('Bültene abone ol', 'Subscribe')}</a></div>}
    </div>
  </header>
  <!-- Bölüm çubuğu: her ekranda tek menü; sayfa kaydırılınca üstte kalır, sığmazsa yana kayar -->
  <nav class="catbar" aria-label={T('Ana menü', 'Main menu')} data-catbar>
    <div class="wrap">
      <a class="catbar-logo" href={L.u('/')} aria-label={T('YZ Gündemi ana sayfa', 'YZ Gündemi home')} tabindex="-1"><span class="wm-badge" aria-hidden="true">YZ</span></a>
      <ul class="nav-main" data-nav>
        <li class="nav-quick"><a href={L.u('/')} aria-current={isHome ? 'page' : undefined}>{T('Gündem', 'Top stories')}</a></li>
        <li class="nav-quick"><a href={L.u('/akis/')} aria-current={path.startsWith(L.u('/akis/')) ? 'page' : undefined}>{T('Akış', 'Latest')}</a></li>
        {navGroups.map((g) => (
          <li class="nav-group-item">
            <details class={`nav-group${g.items.some((i) => i.current) ? ' has-current' : ''}`} data-nav-group>
              <summary>{g.label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <div class={`nav-panel${g.cols ? ' nav-panel-cols' : ''}${g.right ? ' nav-panel-right' : ''}`}>
                <ul>{g.items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}{i.desc && <span>{i.desc}</span>}</a></li>)}</ul>
              </div>
            </details>
          </li>
        ))}
        <li class="nav-mobile">
          <details class={`nav-group nav-all${navGroups.some((g) => g.items.some((i) => i.current)) ? ' has-current' : ''}`} data-nav-group>
            <summary>{T('Menü', 'Menu')}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <div class="nav-panel nav-panel-full">
              {navGroups.map((g) => (
                <section>
                  <h2>{g.label}</h2>
                  <ul>{g.items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.label}</a></li>)}</ul>
                </section>
              ))}
            </div>
          </details>
        </li>
      </ul>
      <a class="catbar-search" href={L.u('/ara/')} aria-label={T('Haberlerde ara', 'Search')} title={T('Haberlerde ara', 'Search')} aria-current={Astro.url.pathname.startsWith(L.u('/ara/')) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a class="lang-switch" href={switchHref} hreflang={lang === 'en' ? 'tr' : 'en'} lang={lang === 'en' ? 'tr' : 'en'} title={lang === 'en' ? 'Türkçe sürüm' : 'English version'} aria-label={lang === 'en' ? 'Türkçe sürüme geç' : 'Switch to English'}>{lang === 'en' ? 'TR' : 'EN'}</a>
      <button type="button" class="theme-btn" role="switch" aria-checked="false" aria-label={T('Koyu tema', 'Dark theme')} title={T('Koyu temaya geç', 'Switch to dark theme')} data-theme-toggle>
        <span class="tb-track" aria-hidden="true">
          <svg class="tb-ico tb-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="tb-ico tb-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <span class="tb-knob"></span>
        </span>
      </button>
    </div>
  </nav>

  <main class="wrap" id="icerik" tabindex="-1"><slot /></main>

  <footer class="site">
    <div class="wrap foot-main">
      <div class="foot-about">
        <a class="logo" href={L.u('/')} aria-label={T('YZ Gündemi ana sayfa', 'YZ Gündemi home')}><span class="wm" aria-hidden="true"><span class="wm-badge">YZ</span><span class="wm-text"><span class="wm-sub">{T('YAPAY ZEKA', 'AI NEWS')}</span><span class="wm-main">Gündemi</span></span></span></a>
        <p>{SITE_DESC}</p>
        <p class="foot-ai">{T('Haberler yapay zeka desteğiyle, belirtilen kaynaklardan derlenir; her haberin altında kaynak bağlantıları yer alır.', 'Stories are compiled with AI assistance from the cited sources; every article links to its sources.')} <a href={L.u('/hakkimizda/')}>{T('Nasıl çalışıyoruz?', 'How we work')}</a></p>
      </div>
      <nav class="foot-col foot-cats" aria-labelledby="foot-cats">
        <h2 id="foot-cats">{T('Haberler', 'News')}</h2>
        <ul>{footerCats.map((c) => <li><a href={L.u(`/kategori/${c.slug}/`)}>{S(`cat.${c.slug}.name`, c.name)}</a></li>)}</ul>
      </nav>
      <nav class="foot-col" aria-labelledby="foot-tools">
        <h2 id="foot-tools">{T('Araç rehberi', 'AI tools')}</h2>
        <ul>{navGroups[1].items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav class="foot-col foot-cats foot-explore" aria-labelledby="foot-explore">
        <h2 id="foot-explore">{T('Keşfet', 'Explore')}</h2>
        <ul>{[...navGroups[2].items.filter((i) => !i.href.includes('/sozluk/yapay-zeka')), item(T('İş kolları', 'Industries'), '/sektor/'), ...navGroups.at(-2).items.filter((i) => !i.href.includes('/kategori/')), ...navGroups.at(-1).items].filter((i) => liveSectors.length || !/\/(sektor|industries)\/$/.test(i.href)).map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
      <nav class="foot-col" aria-labelledby="foot-site">
        <h2 id="foot-site">YZ Gündemi</h2>
        <ul>
          <li><a href={L.u('/hakkimizda/')}>{T('Hakkımızda', 'About us')}</a></li>
          <li><a href={L.u('/kunye/')}>{T('Künye', 'Masthead')}</a></li>
          <li><a href={L.u('/hata-bildir/')}>{T('Hata bildir', 'Report an error')}</a></li>
          <li><a href={L.u('/duzeltmeler/')}>{T('Düzeltmeler', 'Corrections')}</a></li>
          <li><a href={L.u('/akis/')}>{T('Canlı akış', 'Live feed')}</a></li>
          <li><a href={L.u('/rss.xml')}>RSS</a></li>
          <li><a href={switchHref} hreflang={lang === 'en' ? 'tr' : 'en'} lang={lang === 'en' ? 'tr' : 'en'}>{lang === 'en' ? 'Türkçe' : 'English'}</a></li>
          {newsletterOn && <li><a href={L.u('/') + '#bulten'}>{T('E-posta bülteni', 'Newsletter')}</a></li>}
          {SITE.social?.x && <li><a href={`https://x.com/${SITE.social.x}`}>X</a></li>}
          {SITE.social?.instagram && <li><a href={`https://www.instagram.com/${SITE.social.instagram}/`}>Instagram</a></li>}
          {SITE.social?.linkedin && <li><a href={`https://www.linkedin.com/company/${SITE.social.linkedin}/`}>LinkedIn</a></li>}
        </ul>
      </nav>
    </div>
    <div class="foot-bottom"><div class="wrap">
      <p>© {year} {SITE.name} · {SITE.domain}</p>
      <p class="foot-credits">{T('Fotoğraflar', 'Photos from')} <a href="https://unsplash.com/?utm_source=yzgundemi&utm_medium=referral">Unsplash</a>{T(', şirket logoları ', ', company logos from ')}<a href="https://simpleicons.org/">Simple Icons</a>{T(' kaynaklıdır; logolar sahiplerinin markasıdır.', '; logos are trademarks of their owners.')}</p>
      <span class="foot-links"><a href={L.u('/kullanim-kosullari/')}>{T('Kullanım koşulları', 'Terms of use')}</a><a href={L.u('/gizlilik/')}>{T('Gizlilik ve çerezler', 'Privacy and cookies')}</a>{SITE.analytics?.ga4 && <button type="button" class="linkish" data-consent-open>{T('Çerez tercihleri', 'Cookie settings')}</button>}</span>
      <a class="foot-top" href="#icerik">{T('Başa dön', 'Back to top')} <span aria-hidden="true">↑</span></a>
    </div></div>
  </footer>

  {SITE.analytics?.ga4 && (
    <div class="consent" data-consent data-ga={SITE.analytics.ga4} role="region" aria-label={T('Çerez tercihi', 'Cookie consent')} hidden>
      <div class="wrap">
        <p>{T('Hangi haberlerin okunduğunu Google Analytics ile ölçüyoruz. İzin verirseniz tarayıcınıza istatistik çerezleri yerleştirilir; izin vermezseniz yalnızca çerezsiz, anonim sayım yapılır. Reklam çerezi kullanılmaz.', 'We measure which stories are read with Google Analytics. If you allow it, statistics cookies are set in your browser; if not, only cookieless, anonymous counting is used. No advertising cookies.')} <a href={L.u('/gizlilik/')}>{T('Ayrıntılar', 'Details')}</a></p>
        <div class="consent-actions">
          <button type="button" class="btn btn-ghost" data-consent-choice="denied">{T('Reddet', 'Decline')}</button>
          <button type="button" class="btn" data-consent-choice="granted">{T('Kabul et', 'Accept')}</button>
        </div>
      </div>
    </div>
  )}

  <script>
    // Çerez bandı: Analytics zaten yüklü (çerezsiz). "Kabul et" çerezli ölçümü açar, "Reddet" çerezleri siler.
    const consentBox = document.querySelector<HTMLElement>('[data-consent]');
    if (consentBox) {
      const KEY = 'yz-cerez-izni';
      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
      const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch {} };
      const g = (...a: unknown[]) => { const w = window as any; if (typeof w.gtag === 'function') w.gtag(...a); };
      const clearGA = () => {
        const host = location.hostname.replace(/^www\./, '');
        document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter((n) => /^_ga/.test(n)).forEach((n) => {
          for (const d of ['', `; domain=${host}`, `; domain=.${host}`]) document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d}`;
        });
      };
      const choice = read();
      if (choice !== 'granted' && choice !== 'denied') consentBox.hidden = false;
      consentBox.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((b) => b.addEventListener('click', () => {
        const v = b.dataset.consentChoice!;
        save(v);
        consentBox.hidden = true;
        g('consent', 'update', { analytics_storage: v });
        if (v === 'denied') clearGA();
      }));
      document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', () => { consentBox.hidden = false; consentBox.querySelector('button')?.focus(); }));
    }
    // "Son dakika" etiketi: haber 6 saatten eskiyse ziyaret anında "Son haber"e döner
    const EN = document.documentElement.lang === 'en';
    const badgeText = (iso: string) => (Date.now() - new Date(iso).getTime() < 6 * 3600e3 ? (EN ? 'Breaking' : 'Son dakika') : (EN ? 'Latest' : 'Son haber'));
    document.querySelectorAll<HTMLElement>('[data-breaking]').forEach((b) => { b.textContent = badgeText(b.dataset.breaking!); });
    // Şerit 3 saniyede bir sonraki habere geçer; fare üzerindeyken veya klavye odağındayken durur
    const ticker = document.querySelector<HTMLElement>('[data-ticker]');
    const items = ticker ? [...ticker.querySelectorAll<HTMLAnchorElement>('a')] : [];
    const badge = document.querySelector<HTMLElement>('.ticker .badge');
    if (ticker && items.length > 1) {
      let i = 0, paused = false;
      const pause = (v: boolean) => () => { paused = v; };
      ticker.addEventListener('mouseenter', pause(true));
      ticker.addEventListener('mouseleave', pause(false));
      ticker.addEventListener('focusin', pause(true));
      ticker.addEventListener('focusout', pause(false));
      setInterval(() => {
        if (paused || document.hidden) return;
        items[i].hidden = true;
        i = (i + 1) % items.length;
        items[i].hidden = false;
        if (badge) badge.textContent = badgeText(items[i].dataset.date!);
      }, 3000);
    }
    // Bölüm çubuğu: üstte yapışınca küçük logo görünür; yana kayan listede devamı varsa kenar solar; seçili bölüm görünür alana kaydırılır
    const catbar = document.querySelector<HTMLElement>('[data-catbar]');
    const scroller = document.querySelector<HTMLElement>('[data-catbar-scroll]');
    const masthead = document.querySelector<HTMLElement>('header.site');
    // Seçili bölüm listede görünmüyorsa görünür alana kaydır
    const showCurrent = () => {
      const cur = scroller?.querySelector<HTMLElement>('[aria-current="page"]');
      if (!scroller || !cur) return;
      const s = scroller.getBoundingClientRect(), c = cur.getBoundingClientRect();
      if (c.right > s.right - 8) scroller.scrollLeft += c.right - s.right + 24;
      else if (c.left < s.left) scroller.scrollLeft -= s.left - c.left + 24;
    };
    if (catbar && masthead && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        catbar.classList.toggle('is-stuck', !e.isIntersecting);
        setTimeout(showCurrent, 220); // küçük logonun açılma süresinden sonra
      }).observe(masthead);
    }
    // Gruplu menü: aynı anda tek grup açık; dışarı tıklayınca veya Escape ile kapanır
    const groups = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]')];
    groups.forEach((g) => g.addEventListener('toggle', () => { if (g.open) groups.forEach((o) => { if (o !== g) o.open = false; }); }));
    document.addEventListener('click', (e) => groups.forEach((g) => { if (g.open && !g.contains(e.target as Node)) g.open = false; }));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const g = groups.find((x) => x.open);
      if (g) { g.open = false; g.querySelector('summary')?.focus(); }
    });
    if (scroller) {
      const edges = () => {
        const max = scroller.scrollWidth - scroller.clientWidth;
        scroller.classList.toggle('fade-r', scroller.scrollLeft < max - 2);
        scroller.classList.toggle('fade-l', scroller.scrollLeft > 2);
      };
      scroller.addEventListener('scroll', edges, { passive: true });
      window.addEventListener('resize', edges);
      showCurrent();
      edges();
    }
    // Tema düğmesi (ikon): seçim tarayıcıda saklanır; seçim yoksa cihaz ayarı geçerli
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : media.matches;
    const sync = () => document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.setAttribute('aria-checked', String(isDark()));
      b.title = isDark() ? (EN ? 'Switch to light theme' : 'Açık temaya geç') : (EN ? 'Switch to dark theme' : 'Koyu temaya geç');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
    });
    media.addEventListener('change', sync);
    sync();

    // Cihazın kendi paylaş menüsü (telefonlarda): destekleniyorsa görünür
    document.querySelectorAll<HTMLButtonElement>('[data-share-native]').forEach((b) => {
      if (!navigator.share || !matchMedia('(pointer: coarse)').matches) return;
      b.hidden = false;
      b.addEventListener('click', async () => { try { await navigator.share({ title: b.dataset.title, url: location.href }); } catch {} });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(location.href); b.textContent = EN ? 'Copied' : 'Kopyalandı'; }
        catch { b.textContent = location.href; }
      });
    });
    // Instagram'ın web paylaşım adresi yok: telefonda cihazın paylaş menüsü açılır (Instagram oradan seçilir),
    // bilgisayarda bağlantı kopyalanır ve nasıl paylaşılacağı yazılır.
    document.querySelectorAll<HTMLButtonElement>('[data-share-ig]').forEach((b) => {
      const note = b.parentElement?.querySelector<HTMLElement>('.share-note');
      b.addEventListener('click', async () => {
        const mobile = matchMedia('(pointer: coarse)').matches;
        if (mobile && navigator.share) {
          try { await navigator.share({ title: b.dataset.title, url: location.href }); } catch {}
          return;
        }
        try {
          await navigator.clipboard.writeText(location.href);
          if (note) note.textContent = EN ? 'Link copied. Paste it into an Instagram story link sticker or a DM.' : "Bağlantı kopyalandı. Instagram'da hikâyene bağlantı çıkartması olarak ya da DM'e yapıştırabilirsin.";
        } catch {
          if (note) note.textContent = location.href;
        }
      });
    });
  </script>
</body>
</html>
