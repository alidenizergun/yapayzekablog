---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { TOOLS, TOOL_CATS, TASKS, COMPARISONS, TOOLS_CHECKED, toolBySlug, compareSlug, trDate, toolUrl, vsTr, withGen } from '../../lib/tools.js';
import { PROMPTS } from '../../lib/prompts.js';
import { url } from '../../lib/news.js';
import { i18n, locTask, toolCat, dateL } from '../../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;

const groups = TOOL_CATS.map((c) => ({ ...c, items: TOOLS.filter((t) => t.cats[0] === c.slug) })).filter((g) => g.items.length);
const pageUrl = new URL(url('/arac/'), Astro.site).href;
const checkedL = lang === 'en' ? dateL(TOOLS_CHECKED, 'en') : trDate(TOOLS_CHECKED);
const freeN = TOOLS.filter((t) => t.free === 'var' || t.free === 'deneme').length;
const trN = TOOLS.filter((t) => t.turkish).length;
// "Yeni eklenenler": dizinin ilk yayınından (en eski eklenme tarihi) sonra eklenen araçlar
const FIRST = TOOLS.map((t) => t.added).sort()[0];
const newN = TOOLS.filter((t) => t.added > FIRST).length;
const topTasks = TASKS.slice(0, 12);
// Sekmelerde kısa adlar: hepsi tek satıra sığsın (bölüm başlıklarında tam ad kalır)
const SHORT = { asistan: ['Sohbet', 'Chat'], gorsel: ['Görsel', 'Image'], video: ['Video', 'Video'], ses: ['Ses ve müzik', 'Audio'], kod: ['Kodlama', 'Coding'],
  verimlilik: ['Verimlilik', 'Productivity'], arastirma: ['Araştırma', 'Research'], ajan: ['Ajanlar', 'Agents'], uygulama: ['Uygulama yapma', 'App builders'] };
const shortCat = (slug) => (SHORT[slug] ? SHORT[slug][lang === 'en' ? 1 : 0] : toolCat(slug, lang));
const jsonLd = { '@type': 'CollectionPage', name: T('Yapay zeka araçları', 'AI tools'), url: pageUrl, inLanguage: L.locale,
  mainEntity: { '@type': 'ItemList', itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: new URL(url(toolUrl(t.slug)), Astro.site).href })) } };
---
<Base title={T('Yapay zeka araçları: fiyatlar, ücretsiz planlar ve alternatifler', 'AI tools directory: pricing, free plans and alternatives')} description={T(`ChatGPT, Claude, Gemini, Midjourney, ElevenLabs ve ${TOOLS.length} yapay zeka aracının fiyatları, ücretsiz planları, Türkçe desteği ve alternatifleri; görevlere göre en iyi araçlar ve karşılaştırmalar.`, `Pricing, free plans and alternatives for ${TOOLS.length} AI tools including ChatGPT, Claude, Gemini, Midjourney and ElevenLabs, plus the best tools by task and head-to-head comparisons.`)}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Yapay zeka araçları', 'AI tools'), path: '/arac/' }]}>
  <section class="tools-index tx" data-tools>
    <header class="tx-head">
      <h1 class="page-h">{T('Yapay zeka araçları', 'AI tools')}</h1>
      <p class="tx-lead">{T(`${TOOLS.length} aracın ne işe yaradığı, ne kadar tuttuğu ve ücretsiz kullanılıp kullanılamadığı tek sayfada.`, `What ${TOOLS.length} AI tools do, what they cost and whether you can use them for free, on one page.`)}</p>
      <p class="tx-help">{T('Hangisini seçeceğinizi bilmiyor musunuz?', 'Not sure which one to pick?')} <a href={url('/arac-secici/')}>{T('3 soruda size uygun aracı bulun →', 'Find the right tool in 3 questions →')}</a></p>
    </header>

    <div class="tx-bar" data-tx-bar>
      <div class="tx-tabs" role="group" aria-label={T('Türe göre süz', 'Filter by type')}>
        <button type="button" aria-pressed="true" data-tl-cat="">{T('Tümü', 'All')} <span class="meta">{TOOLS.length}</span></button>
        {groups.map((g) => <button type="button" aria-pressed="false" data-tl-cat={g.slug} title={toolCat(g.slug, lang)}>{shortCat(g.slug)} <span class="meta">{g.items.length}</span></button>)}
      </div>
      <div class="tx-row">
        <div class="tx-flags" role="group" aria-label={T('Özelliğe göre süz', 'Filter by feature')}>
          <button type="button" aria-pressed="false" data-tl-flag="free"><span class="tx-box" aria-hidden="true"></span>{T('Ücretsiz kullanılabilir', 'Free to try')} <span class="meta">{freeN}</span></button>
          <button type="button" aria-pressed="false" data-tl-flag="tr"><span class="tx-box" aria-hidden="true"></span>{T('Türkçe kullanılabiliyor', 'Works in Turkish')} <span class="meta">{trN}</span></button>
          {newN > 0 && <button type="button" aria-pressed="false" data-tl-flag="new" data-cut={FIRST}><span class="tx-box" aria-hidden="true"></span>{T('Yeni eklenenler', 'Recently added')} <span class="meta">{newN}</span></button>}
        </div>
        <p class="tx-count" aria-live="polite"><span data-tl-count>{T(`${TOOLS.length} araç`, `${TOOLS.length} tools`)}</span> <button type="button" class="tx-reset" data-tl-reset hidden>{T('Süzgeçleri temizle', 'Clear filters')}</button></p>
      </div>
    </div>

    {groups.map((g) => (
      <section class="tool-group" aria-labelledby={`tc-${g.slug}`} data-group={g.slug}>
        <h2 id={`tc-${g.slug}`} class="tx-gh">{toolCat(g.slug, lang)}<span class="meta" data-g-count>{g.items.length}</span></h2>
        <div class="tool-grid">{g.items.map((t) => <ToolCard tool={t} />)}</div>
      </section>
    ))}
    <div class="tx-empty" data-tl-empty hidden>
      <p>{T('Bu ölçütlere uyan araç yok.', 'No tools match these filters.')}</p>
      <button type="button" class="btn" data-tl-reset>{T('Süzgeçleri temizle', 'Clear filters')}</button>
    </div>

    <section class="tx-more" aria-labelledby="tx-more-h">
      <h2 id="tx-more-h" class="tx-gh">{T('Karar vermenize yardımcı olacaklar', 'Help deciding')}</h2>
      <div class="tx-more-grid">
        <div>
          <h3>{T('İşe göre en iyi araçlar', 'Best tools by task')}</h3>
          <ul class="chip-row">{topTasks.map((k) => <li><a href={url(`/en-iyi/${k.slug}/`)}>{locTask(k, lang).short}</a></li>)}</ul>
          <a class="tx-all" href={url('/en-iyi-yapay-zeka-uygulamalari/')}>{T(`Tüm listeler (${TASKS.length}) →`, `All lists (${TASKS.length}) →`)}</a>
        </div>
        <div>
          <h3>{T('Karşılaştırmalar', 'Comparisons')}</h3>
          <ul class="cmp-links">{COMPARISONS.slice(0, 6).map(([a, b]) => <li><a href={url(`/karsilastir/${compareSlug(a, b)}/`)}>{T(vsTr(toolBySlug(a), toolBySlug(b)), `${toolBySlug(a).name} vs ${toolBySlug(b).name}`)}</a></li>)}</ul>
          <a class="tx-all" href={url('/karsilastir/')}>{T(`Tüm karşılaştırmalar (${COMPARISONS.length}) →`, `All comparisons (${COMPARISONS.length}) →`)}</a>
        </div>
        <div>
          <h3>{T('Fiyatlar ve komutlar', 'Prices and prompts')}</h3>
          <ul class="cmp-links">
            <li><a href={url('/yapay-zeka-abonelikleri/')}>{T('Tüm abonelik fiyatları, dolar ve TL', 'All subscription prices')}</a></li>
            <li><a href={url('/ucretsiz-yapay-zeka-araclari/')}>{T('Ücretsiz yapay zeka araçları', 'Free AI tools')}</a></li>
            <li><a href={url('/yapay-zeka-komutlari/')}>{T(`${PROMPTS.length} hazır Türkçe komut`, `${PROMPTS.length} ready-to-use prompts`)}</a></li>
          </ul>
        </div>
      </div>
    </section>

    {lang === 'en' ? (
    <details class="method tx-method" id="yontem">
      <summary>How we compile this · last checked {checkedL}</summary>
      <ul>
        <li><strong>Prices:</strong> Taken from each tool's official pricing page wherever possible; when that isn't reachable we use a dated secondary source and label it as such. We don't publish prices we can't verify.</li>
        <li><strong>Lira equivalents:</strong> Dollar prices are converted at the Central Bank of Turkey (TCMB) selling rate; taxes and local pricing may change what you actually pay.</li>
        <li><strong>Turkish support:</strong> We only say a tool works in Turkish when we can verify it; otherwise we say "not verified".</li>
        <li><strong>Rankings and picks:</strong> We don't score tools. Picks on our "best" pages are editorial, based on adoption, fit for the job and features the companies disclose. No tool pays to be listed, and our links are not affiliate links.</li>
        <li><strong>Updates:</strong> Last full check: {dateL(TOOLS_CHECKED, 'en')}. Spotted an error? <a href={url('/hata-bildir/')}>Let us know</a>.</li>
      </ul>
    </details>
    ) : (
    <details class="method tx-method" id="yontem">
      <summary>Bu bilgileri nasıl derliyoruz? · Son kontrol: {checkedL}</summary>
      <ul>
        <li><strong>Fiyatlar:</strong> Mümkün olduğunca aracın resmi fiyat sayfasından alınır; resmi sayfaya ulaşılamadığında tarihli ikincil kaynak kullanılır ve sayfada "ikincil kaynak" olarak belirtilir. Doğrulayamadığımız fiyatı yazmayız.</li>
        <li><strong>TL karşılıkları:</strong> Dolar fiyatları TCMB döviz satış kuruyla çevrilir; vergiler ve yerel fiyatlandırma nedeniyle ödenen tutar farklı olabilir.</li>
        <li><strong>Türkçe desteği:</strong> Yalnızca aracın Türkçe kullanılabildiğini doğrulayabildiğimizde belirtiriz; emin olmadığımız yerde "doğrulanmadı" yazarız.</li>
        <li><strong>Sıralama ve seçim:</strong> Araçlara puan vermeyiz. "En iyi" sayfalarındaki seçimler; yaygınlık, işe uygunluk ve şirketlerin açıkladığı özelliklere dayanan editoryal seçimdir. Hiçbir araç bu listelerde yer almak için ödeme yapmaz; bağlantılarımız satış ortaklığı (affiliate) bağlantısı değildir.</li>
        <li><strong>Güncelleme:</strong> Son genel kontrol: {trDate(TOOLS_CHECKED)}. Hata görürseniz <a href={url('/hata-bildir/')}>bildirin</a>.</li>
      </ul>
    </details>
    )}
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-tools]');
  if (root) {
    const q = root.querySelector<HTMLInputElement>('[data-tl-q]');
    const cards = [...root.querySelectorAll<HTMLElement>('.tool-card')];
    const groups = [...root.querySelectorAll<HTMLElement>('.tool-group')];
    const count = root.querySelector<HTMLElement>('[data-tl-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-tl-empty]')!;
    const resets = [...root.querySelectorAll<HTMLButtonElement>('[data-tl-reset]')];
    const bar = root.querySelector<HTMLElement>('[data-tx-bar]');
    const catbar = document.querySelector<HTMLElement>('[data-catbar]');
    // Süzgeç çubuğu menü çubuğunun hemen altında yapışık kalır
    const stick = () => { if (bar && catbar) bar.style.top = `${catbar.offsetHeight - 1}px`; };
    stick(); addEventListener('resize', stick);
    const flags = new Set<string>();
    let cat = '';
    const norm = (s: string) => s.toLocaleLowerCase('tr').replace(/ı/g, 'i').normalize('NFKD').replace(/[\u0300-\u036f]/g, '');
    const texts = new Map(cards.map((c) => [c, norm(c.textContent || '')]));
    const cut = root.querySelector<HTMLElement>('[data-tl-flag="new"]')?.dataset.cut || '9999';
    const EN = document.documentElement.lang === 'en';
    const catBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tl-cat]')];
    const flagBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tl-flag]')];
    const apply = () => {
      const v = q ? norm(q.value.trim()) : '';
      let n = 0;
      groups.forEach((g) => {
        let gn = 0;
        g.querySelectorAll<HTMLElement>('.tool-card').forEach((c) => {
          const ok = (!cat || g.dataset.group === cat) && (!v || texts.get(c)!.includes(v)) && (!flags.has('free') || c.dataset.free) && (!flags.has('tr') || c.dataset.tr) && (!flags.has('new') || (c.dataset.added || '') > cut);
          c.hidden = !ok; if (ok) gn++;
        });
        g.hidden = gn === 0; n += gn;
        const gc = g.querySelector('[data-g-count]'); if (gc) gc.textContent = String(gn);
      });
      const filtered = Boolean(v || cat || flags.size);
      count.textContent = EN ? `${n} ${filtered ? 'of ' + cards.length + ' tools shown' : 'tools'}` : (filtered ? `${cards.length} araçtan ${n} tanesi gösteriliyor` : `${n} araç`);
      resets[0].hidden = !filtered;
      empty.hidden = n > 0;
    };
    const scrollToList = () => { const top = bar ? bar.getBoundingClientRect().top + scrollY - parseFloat(bar.style.top || '0') : 0; if (scrollY > top) scrollTo({ top, behavior: 'smooth' }); };
    flagBtns.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.tlFlag!; if (flags.has(f)) flags.delete(f); else flags.add(f);
      b.setAttribute('aria-pressed', String(flags.has(f))); apply(); scrollToList();
    }));
    catBtns.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.tlCat || ''; catBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); scrollToList(); }));
    resets.forEach((r) => r.addEventListener('click', () => {
      if (q) q.value = ''; cat = ''; flags.clear();
      catBtns.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
      flagBtns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      apply();
    }));
    q?.addEventListener('input', apply);
  }
</script>
