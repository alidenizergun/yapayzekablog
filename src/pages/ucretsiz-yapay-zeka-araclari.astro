---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOLS, TOOL_CATS, TOOLS_CHECKED, trDate, toolUrl } from '../lib/tools.js';
import { url } from '../lib/news.js';

const free = TOOLS.filter((t) => t.free === 'var');
const trial = TOOLS.filter((t) => t.free === 'deneme');
const groups = TOOL_CATS.map((c) => ({ ...c, items: free.filter((t) => t.cats[0] === c.slug) })).filter((g) => g.items.length);
const jsonLd = { '@type': 'ItemList', name: 'Ücretsiz yapay zeka araçları', itemListElement: free.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: new URL(url(toolUrl(t.slug)), Astro.site).href })) };
---
<Base title="Ücretsiz yapay zeka araçları: ücretsiz planı olan en iyi uygulamalar" description={`Ücretsiz kullanılabilen ${free.length} yapay zeka aracı: sohbet, görsel, video, ses, kodlama, çeviri ve araştırma için ücretsiz planı olan uygulamalar ve sınırları.`}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: 'Yapay zeka araçları', path: '/arac/' }, { name: 'Ücretsiz araçlar', path: '/ucretsiz-yapay-zeka-araclari/' }]}>
  <section class="glossary" data-pagefind-body>
    <span class="cat">Ücretsiz</span>
    <h1 class="page-h">Ücretsiz yapay zeka araçları</h1>
    <p class="spot">Kalıcı ücretsiz planı olan yapay zeka araçları. Ücretsiz planlar genellikle kullanım sınırı, daha eski modeller veya ticari kullanım kısıtlamasıyla gelir; ayrıntılar her aracın sayfasında.</p>
    <p class="models-checked">Son kontrol: {trDate(TOOLS_CHECKED)}</p>
    {groups.map((g) => (
      <section aria-labelledby={`fc-${g.slug}`}>
        <h2 id={`fc-${g.slug}`} class="ev-h">{g.name}</h2>
        <div class="tool-grid">{g.items.map((t) => <ToolCard tool={t} />)}</div>
      </section>
    ))}
    {trial.length > 0 && (
      <section aria-labelledby="fc-trial">
        <h2 id="fc-trial" class="ev-h">Ücretsiz deneme veya kredi sunanlar</h2>
        <div class="tool-grid">{trial.map((t) => <ToolCard tool={t} />)}</div>
      </section>
    )}
    <aside class="why"><strong>Ücretsiz planlarda dikkat</strong><p>Ücretsiz kullanımda yazdıklarınız modelin eğitiminde kullanılabilir; gizlilik ayarlarını kontrol edin. Görsel ve müzik araçlarında ücretsiz planla üretilen içeriğin ticari kullanımı çoğu zaman yasaktır. Ayrıntılar: <a href={url('/rehber/yapay-zeka-kullanirken-kisisel-verileri-koruma/')}>kişisel verileri koruma rehberi</a>.</p></aside>
  </section>
</Base>
