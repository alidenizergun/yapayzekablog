---
import SubNav from '../components/SubNav.astro';
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOLS, TOOL_CATS, TOOLS_CHECKED, trDate, toolUrl } from '../lib/tools.js';
import { url } from '../lib/news.js';
import { i18n, toolCat, dateL } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;

const free = TOOLS.filter((t) => t.free === 'var');
const trial = TOOLS.filter((t) => t.free === 'deneme');
const groups = TOOL_CATS.map((c) => ({ ...c, items: free.filter((t) => t.cats[0] === c.slug) })).filter((g) => g.items.length);
const jsonLd = { '@type': 'ItemList', name: T('Ücretsiz yapay zeka araçları', 'Free AI tools'), itemListElement: free.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: new URL(url(toolUrl(t.slug)), Astro.site).href })) };
---
<Base title={T('Ücretsiz yapay zeka araçları: ücretsiz planı olan en iyi uygulamalar', 'Free AI tools: the best apps with a free plan')} description={T(`Ücretsiz kullanılabilen ${free.length} yapay zeka aracı: sohbet, görsel, video, ses, kodlama, çeviri ve araştırma için ücretsiz planı olan uygulamalar ve sınırları.`, `${free.length} AI tools you can use for free: chat, image, video, audio, coding, translation and research apps with a free plan, and their limits.`)}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Yapay zeka araçları', 'AI tools'), path: '/arac/' }, { name: T('Ücretsiz araçlar', 'Free tools'), path: '/ucretsiz-yapay-zeka-araclari/' }]}>
  <SubNav set="tools" />
  <section class="glossary" data-pagefind-body>
    <span class="cat">{T('Ücretsiz', 'Free')}</span>
    <h1 class="page-h">{T('Ücretsiz yapay zeka araçları', 'Free AI tools')}</h1>
    <p class="spot">{T('Kalıcı ücretsiz planı olan yapay zeka araçları. Ücretsiz planlar genellikle kullanım sınırı, daha eski modeller veya ticari kullanım kısıtlamasıyla gelir; ayrıntılar her aracın sayfasında.', 'AI tools with a permanent free plan. Free plans usually come with usage caps, older models or limits on commercial use; details are on each tool page.')}</p>
    <p class="models-checked">{T('Son kontrol', 'Last checked')}: {dateL(TOOLS_CHECKED, lang)}</p>
    {groups.map((g) => (
      <section aria-labelledby={`fc-${g.slug}`}>
        <h2 id={`fc-${g.slug}`} class="ev-h">{toolCat(g.slug, lang)}</h2>
        <div class="tool-grid">{g.items.map((t) => <ToolCard tool={t} />)}</div>
      </section>
    ))}
    {trial.length > 0 && (
      <section aria-labelledby="fc-trial">
        <h2 id="fc-trial" class="ev-h">{T('Ücretsiz deneme veya kredi sunanlar', 'Free trials or credits')}</h2>
        <div class="tool-grid">{trial.map((t) => <ToolCard tool={t} />)}</div>
      </section>
    )}
    {lang === 'en' ? <aside class="why"><strong>Watch out on free plans</strong><p>What you type on a free plan may be used to train the model, so check the privacy settings. Image and music tools often bar commercial use of content made on a free plan. More: <a href={url('/rehber/yapay-zeka-kullanirken-kisisel-verileri-koruma/')}>protecting your personal data</a>.</p></aside> : <aside class="why"><strong>Ücretsiz planlarda dikkat</strong><p>Ücretsiz kullanımda yazdıklarınız modelin eğitiminde kullanılabilir; gizlilik ayarlarını kontrol edin. Görsel ve müzik araçlarında ücretsiz planla üretilen içeriğin ticari kullanımı çoğu zaman yasaktır. Ayrıntılar: <a href={url('/rehber/yapay-zeka-kullanirken-kisisel-verileri-koruma/')}>kişisel verileri koruma rehberi</a>.</p></aside>}
  </section>
</Base>
