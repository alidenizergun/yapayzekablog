---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import Time from '../../components/Time.astro';
import { getNews, newsUrl, catName, formatDate, url } from '../../lib/news.js';
import { storyIndex } from '../../lib/stories.js';

export async function getStaticPaths() {
  const idx = storyIndex(await getNews());
  return [...idx.values()].map(({ story, items }) => ({ params: { slug: story.slug }, props: { story, items } }));
}
const { story: s, items } = Astro.props;
// Tarihe göre grupla (eskiden yeniye)
const days = [];
for (const n of items) {
  const day = formatDate(n.data.date, false);
  if (!days.length || days.at(-1).day !== day) days.push({ day, list: [] });
  days.at(-1).list.push(n);
}
const first = items[0].data.date, last = items.at(-1).data.date;
const pageUrl = new URL(url(`/gelisme/${s.slug}/`), Astro.site).href;
const jsonLd = {
  '@type': 'CollectionPage', name: `${s.title}: olayların gelişimi`, description: s.intro, inLanguage: 'tr-TR', url: pageUrl,
  dateModified: last.toISOString(),
  mainEntity: { '@type': 'ItemList', itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: items.map((n, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(newsUrl(n), Astro.site).href, name: n.data.title })) },
};
---
<Base title={`${s.title}: olayların gelişimi`} description={s.intro} jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: 'Gelişen hikâyeler', path: '/gelisme/' }, { name: s.title, path: `/gelisme/${s.slug}/` }]}>
  <div class="cols" style="margin-top:0">
    <article class="article story" data-pagefind-body data-pagefind-meta={`date:${formatDate(last, false)}`}>
      <nav class="crumb" aria-label="Konum" data-pagefind-ignore><a href={url('/')}>Ana sayfa</a><span aria-hidden="true">/</span><a href={url('/gelisme/')}>Gelişen hikâyeler</a></nav>
      <span class="badge" data-pagefind-ignore>Gelişen hikâye</span>
      <h1 data-pagefind-meta="title">{s.title}: olayların gelişimi</h1>
      <p class="spot">{s.intro}</p>
      <p class="meta story-meta" data-pagefind-ignore>{items.length} haber · {formatDate(first, false)} - {formatDate(last, false)} · Son güncelleme: <Time date={last} /></p>
      <ol class="timeline">
        {days.map((g) => (
          <li class="tl-day">
            <h2 class="tl-date">{g.day}</h2>
            <ol>
              {g.list.map((n) => (
                <li class="tl-item">
                  <a href={newsUrl(n)}>
                    <span class="cat">{catName(n.data.category)}</span>
                    <h3>{n.data.title}</h3>
                    <p>{n.data.spot}</p>
                  </a>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </article>
    <Sidebar exclude={items.map((n) => n.id)} />
  </div>
</Base>
