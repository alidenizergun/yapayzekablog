---
import Base from '../../layouts/Base.astro';
import Time from '../../components/Time.astro';
import { getNews, url } from '../../lib/news.js';
import { storyIndex } from '../../lib/stories.js';
const list = [...storyIndex(await getNews()).values()].sort((a, b) => b.items.at(-1).data.date - a.items.at(-1).data.date);
---
<Base title="Gelişen hikâyeler" description="Birkaç gün süren yapay zeka gelişmelerinin bütün haberleri, tarih sırasıyla tek sayfada."
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: 'Gelişen hikâyeler', path: '/gelisme/' }]}>
  <section class="digest-index">
    <h1 class="page-h">Gelişen hikâyeler</h1>
    <p class="spot">Birkaç gün süren gelişmelerin bütün haberleri, tarih sırasıyla tek sayfada.</p>
    <ol class="digest-archive">
      {list.map(({ story: s, items }) => (
        <li><a href={url(`/gelisme/${s.slug}/`)}>
          <span class="cat">{items.length} haber · son gelişme <Time date={items.at(-1).data.date} /></span>
          <h2>{s.title}</h2>
          <p>{s.intro}</p>
        </a></li>
      ))}
    </ol>
  </section>
</Base>
