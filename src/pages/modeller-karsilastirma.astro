---
import SubNav from '../components/SubNav.astro';
import Base from '../layouts/Base.astro';
import DataCite from '../components/DataCite.astro';
import NewsRow from '../components/NewsRow.astro';
import { MODELS, MODELS_CHECKED, priceClass } from '../lib/models.js';
import { getNews, newsUrl, formatDate, url } from '../lib/news.js';
import { i18n, locNewsList } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T, S } = L;
const EN = lang === 'en';
const PC_EN = { 'Üst': 'Premium', 'Orta': 'Mid', 'Ekonomik': 'Budget' };
const pcl = (m) => (EN ? PC_EN[priceClass(m)] ?? priceClass(m) : priceClass(m));

const rows = MODELS.map((m, i) => ({ ...m, note: m.note && S(`model.${i}.note`, m.note) })).sort((a, b) => b.output - a.output || b.input - a.input);
const companies = [...new Set(rows.map((m) => m.company))];
const num = (n) => n.toLocaleString(L.locale, { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 });
// Site geneli: Türkçede "20 $", İngilizcede "$20"
const usd = (n) => (EN ? `$${num(n)}` : `${num(n)} $`);
const checked = formatDate(new Date(`${MODELS_CHECKED}T12:00:00+03:00`), false, L.locale);
const modelNews = locNewsList((await getNews()).filter((n) => n.data.category === 'modeller'), lang, L.m).slice(0, 5);
const pageUrl = new URL(url('/modeller-karsilastirma/'), Astro.site).href;
const cheapest = rows.filter((m) => m.input === Math.min(...rows.map((x) => x.input))).map((m) => m.model);
const faqEn = [
  ['What is the cheapest AI model?', `In this table, the lowest per-million-token prices belong to ${cheapest.join(' and ')} (input ${usd(Math.min(...rows.map((x) => x.input)))}). Cheap models suit simple, high-volume work; larger models do better on hard tasks.`],
  ['What is a token, and how is pricing calculated?', 'Tokens are the small chunks of text a language model processes. API pricing is charged separately for the tokens you send (input) and the tokens the model generates (output). Output tokens usually cost several times more than input.'],
  ['What is a context window?', 'The total amount of text a model can take into account at once. 1M (one million) tokens means hundreds of pages of documents or a large codebase.'],
  ['How often are prices updated?', `The table is checked against each company’s official pricing page; last checked ${checked}. Prices change often, so check the official page before you commit.`],
];
const faqTr = [
  ['En ucuz yapay zeka modeli hangisi?', `Bu tablodaki modeller arasında milyon token başına en düşük fiyatlar ${rows.filter((m) => m.input === Math.min(...rows.map((x) => x.input))).map((m) => m.model).join(' ve ')} modellerine ait (girdi ${usd(Math.min(...rows.map((x) => x.input)))}). Ucuz modeller basit ve yüksek hacimli işler için uygundur; zor görevlerde daha büyük modeller daha iyi sonuç verir.`],
  ['Token nedir, fiyat nasıl hesaplanır?', 'Token, dil modellerinin metni işlerken kullandığı küçük parçalardır. API fiyatı, modele gönderilen (girdi) ve modelin ürettiği (çıktı) token sayısına göre ayrı ayrı hesaplanır. Çıktı token\'ı genellikle girdiden birkaç kat pahalıdır.'],
  ['Bağlam penceresi ne demek?', 'Modelin tek seferde dikkate alabildiği toplam metin miktarıdır. 1M (bir milyon) token, yüzlerce sayfalık belge veya büyük bir kod tabanı demektir.'],
  ['Fiyatlar ne sıklıkla güncelleniyor?', `Tablo, şirketlerin resmi fiyat sayfalarından kontrol edilir; son kontrol tarihi ${checked}. Fiyatlar sık değiştiği için satın alma kararından önce resmi sayfayı kontrol edin.`],
];
const faq = EN ? faqEn : faqTr;
const jsonLd = [
  { '@type': 'Dataset', name: T('Yapay zeka modelleri API fiyat karşılaştırması', 'AI model API pricing comparison'), description: T("Önde gelen yapay zeka modellerinin (OpenAI, Anthropic, Google, xAI, DeepSeek ve diğerleri) resmi fiyat sayfalarından derlenen milyon token başına girdi ve çıktı fiyatları ile bağlam pencereleri. YZ Gündemi tarafından düzenli olarak kontrol edilir.", 'Input and output prices per million tokens and context windows for leading AI models from OpenAI, Anthropic, Google, xAI, DeepSeek and others, compiled from official pricing pages and checked regularly by YZ Gündemi.'), isAccessibleForFree: true,
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(url('/veri/model-fiyatlari.csv'), Astro.site).href }],
    url: pageUrl, inLanguage: L.locale, dateModified: MODELS_CHECKED, creator: { '@id': new URL(url('/#organization'), Astro.site).href },
    isBasedOn: [...new Set(rows.map((m) => m.src.url))] },
  { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title={T('Yapay zeka modelleri karşılaştırma: API fiyatları ve bağlam pencereleri', 'AI model pricing comparison: API prices and context windows')} description={T(`ChatGPT (OpenAI), Claude, Gemini ve DeepSeek modellerinin milyon token başına API fiyatları, bağlam pencereleri ve aylık maliyet hesaplayıcı. Son kontrol: ${checked}.`, `API prices per million tokens, context windows and a monthly cost calculator for OpenAI, Claude, Gemini and DeepSeek models. Last checked: ${checked}.`)}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Model API fiyatları', 'AI model API pricing'), path: '/modeller-karsilastirma/' }]}>
  <SubNav set="tools" />
  <SubNav set="prices" />
  <section class="deals models">
    <span class="cat">{T('Karşılaştırma', 'Comparison')}</span>
    <h1 class="page-h">{T('Yapay zeka modelleri karşılaştırma tablosu', 'AI model pricing comparison')}</h1>
    <p class="spot">{T('Önde gelen yapay zeka modellerinin API fiyatları ve bağlam pencereleri. Fiyatlar ABD doları cinsinden, 1 milyon token başınadır; önbellek ve toplu işlem indirimleri dahil değildir. Her satır şirketin resmi kaynağına bağlanır.', 'API prices and context windows for leading AI models. Prices are in US dollars per 1 million tokens, excluding caching and batch discounts. Each row links to the company’s official source.')}</p>
    <p class="models-checked">{T('Son kontrol', 'Last checked')}: <time datetime={MODELS_CHECKED}>{checked}</time></p>

    <div class="deal-filters" role="group" aria-label={T('Şirkete göre süz', 'Filter by company')} data-m-filters>
      <button type="button" aria-pressed="true" data-c="">{T('Tümü', 'All')}</button>
      {companies.map((c) => <button type="button" aria-pressed="false" data-c={c}>{c}</button>)}
    </div>

    <div class="deal-table-wrap">
      <table class="deal-table model-table">
        <thead><tr><th scope="col">Model</th><th scope="col">{T('Şirket', 'Company')}</th><th scope="col" class="num">{T('Girdi', 'Input')}</th><th scope="col" class="num">{T('Çıktı', 'Output')}</th><th scope="col">{T('Bağlam', 'Context')}</th><th scope="col">{T('Fiyat sınıfı', 'Price tier')}</th><th scope="col">{T('Kaynak', 'Source')}</th></tr></thead>
        <tbody>
          {rows.map((m) => (
            <tr data-c={m.company}>
              <td><strong>{m.model}</strong>{m.note && <span class="meta model-note">{m.note}</span>}</td>
              <td><a href={url(`/konu/${m.entity}/`)}>{m.company}</a></td>
              <td class="num">{usd(m.input)}</td>
              <td class="num">{usd(m.output)}</td>
              <td class="nowrap">{m.context ? `${m.context} token` : <span class="meta">{T('Belirtilmemiş', 'Not stated')}</span>}</td>
              <td><span class={`pclass pclass-${priceClass(m) === 'Üst' ? 'ust' : priceClass(m) === 'Orta' ? 'orta' : 'eko'}`}>{pcl(m)}</span></td>
              <td><a class="src" href={m.src.url} rel="noopener">{m.src.label}</a>{m.checked && <span class="meta"> · {formatDate(new Date(`${m.checked}T12:00:00+03:00`), false, L.locale)}</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <DataCite name="Yapay zeka model API fiyatları" nameEn="AI model API pricing" path="/modeller-karsilastirma/" csv="/veri/model-fiyatlari.csv" checked={MODELS_CHECKED} />
    <p class="ai-note">{T("\"Fiyat sınıfı\" YZ Gündemi'nin çıktı fiyatına göre yaptığı sınıflandırmadır (Üst: 20 $ ve üzeri, Orta: 5-20 $, Ekonomik: 5 $ altı); modelin kalitesini değil maliyetini gösterir. \"Belirtilmemiş\": resmi fiyat sayfasında bağlam penceresi yazmıyor.", '“Price tier” is YZ Gündemi’s grouping by output price (Premium: $20 and up, Mid: $5–20, Budget: under $5); it reflects cost, not quality. “Not stated”: the official pricing page doesn’t list a context window.')}</p>

    <section class="calc" aria-labelledby="calc-h" data-calc>
      <h2 id="calc-h">{T('Aylık maliyet hesaplayıcı', 'Monthly cost calculator')}</h2>
      <p>{T('Ayda modele göndereceğiniz ve modelden alacağınız token miktarını girin. Kabaca 1 milyon token, Türkçe metinde birkaç yüz sayfaya karşılık gelir.', 'Enter how many tokens you’ll send to and get back from the model each month. Roughly, 1 million tokens is several hundred pages of text.')}</p>
      <div class="calc-in">
        <label>{T('Girdi (milyon token / ay)', 'Input (million tokens / month)')}<input type="number" min="0" step="0.5" value="10" inputmode="decimal" data-in /></label>
        <label>{T('Çıktı (milyon token / ay)', 'Output (million tokens / month)')}<input type="number" min="0" step="0.5" value="2" inputmode="decimal" data-out /></label>
      </div>
      <ol class="calc-out" data-results aria-live="polite">
        {rows.map((m) => <li data-model={m.model} data-i={m.input} data-o={m.output}><span>{m.model}</span><strong>—</strong></li>)}
      </ol>
      <p class="ai-note">{T('Hesap standart fiyatlarla yapılır; önbellek, toplu işlem, yoğun saat dışı ve uzun istem fiyatları hesaba katılmaz.', 'Uses standard prices; caching, batch, off-peak and long-prompt pricing are not included.')}</p>
    </section>

    <section class="models-faq" aria-labelledby="faq-h">
      <h2 id="faq-h">{T('Sık sorulanlar', 'FAQ')}</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      {EN ? <p>What matters besides price when picking a model? See our guide <a href={url('/rehber/hangi-yapay-zeka-modelini-secmeliyim/')}>Which AI model should I choose?</a> Terms: <a href={url('/sozluk/token/')}>What is a token?</a> · <a href={url('/sozluk/baglam-penceresi/')}>What is a context window?</a></p> : <p>Model seçerken fiyatın yanında başka ne önemli? <a href={url('/rehber/hangi-yapay-zeka-modelini-secmeliyim/')}>Hangi yapay zeka modelini seçmeliyim?</a> rehberine bakın. Terimler için: <a href={url('/sozluk/token/')}>Token nedir?</a> · <a href={url('/sozluk/baglam-penceresi/')}>Bağlam penceresi nedir?</a></p>}
    </section>

    {modelNews.length > 0 && (
      <section class="models-news" aria-labelledby="mn-h">
        <div class="sechead"><h2 id="mn-h">{T('Son model haberleri', 'Latest model news')}</h2><a class="more-link" href={url('/kategori/modeller/')}>{T('Tümü →', 'All →')}</a></div>
        {modelNews.map((n) => <NewsRow item={n} />)}
      </section>
    )}
  </section>
</Base>

<script>
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.model-table tbody tr')];
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-m-filters] button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    rows.forEach((r) => { r.hidden = !!b.dataset.c && r.dataset.c !== b.dataset.c; });
  }));
  const inEl = document.querySelector<HTMLInputElement>('[data-in]')!;
  const outEl = document.querySelector<HTMLInputElement>('[data-out]')!;
  const list = document.querySelector<HTMLOListElement>('[data-results]')!;
  const EN = document.documentElement.lang === 'en';
  const nf = new Intl.NumberFormat(EN ? 'en-US' : 'tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fmt = { format: (c: number) => (EN ? `$${nf.format(c)}` : `${nf.format(c)} $`) };
  const calc = () => {
    const i = Math.max(0, Number(inEl.value) || 0), o = Math.max(0, Number(outEl.value) || 0);
    const items = [...list.children] as HTMLLIElement[];
    items.forEach((li) => { const c = i * Number(li.dataset.i) + o * Number(li.dataset.o); li.dataset.cost = String(c); li.querySelector('strong')!.textContent = fmt.format(c); });
    items.sort((a, b) => Number(a.dataset.cost) - Number(b.dataset.cost)).forEach((li) => list.appendChild(li));
  };
  inEl.addEventListener('input', calc); outEl.addEventListener('input', calc); calc();
</script>
