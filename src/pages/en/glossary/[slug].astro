---
import Page from '../../sozluk/[slug].astro';
import { GLOSSARY } from '../../../lib/glossary.js';
import { GL_EN } from '../../../i18n/index.js';
export function getStaticPaths() {
  return GLOSSARY.map((t) => ({ params: { slug: GL_EN[t.slug] }, props: { t } }));
}
---
<Page {...Astro.props} />
