---
import Base from '../layouts/Base.astro';
import NewsRow from '../components/NewsRow.astro';
import Sidebar from '../components/Sidebar.astro';
import Time from '../components/Time.astro';
import Visual from '../components/Visual.astro';
import { CATEGORIES } from '../lib/site.js';
import { SECTORS } from '../lib/sectors.js';
import { getCollection } from 'astro:content';
import { i18n, locNewsList } from '../i18n/index.js';
import { getNews, pickLead, getTags, tagSlug, newsUrl, spreadVisuals, hasRealVisual, photoSet, catName, catUrl, tagUrl, url, HOME_MAIN } from '../lib/news.js';

// Ana sayfa önem sırası:
// 1. Manşet + 3 yan haber   2. Öne çıkanlar (3 kart)   3. Son haberler listesi + kenar çubuğu
// 4. Kategori blokları (1 büyük + 3 küçük)
const L = await i18n(Astro);
const { lang, T, S } = L;
const news = locNewsList(await getNews(), lang, L.m);
const cn = (slug) => S(`cat.${slug}.name`, catName(slug));

// Manşet: en son 5 haberden fotoğraflı ya da logolu olanların en yüksek puanlısı (src/lib/news.js › pickLead)
const lead = pickLead(news);
// Manşet alanındaki yan haberler de görselli olmalı (illüstrasyon yok): görseli olan ilk 3 haber
const others = news.filter((n) => n !== lead);
const side = others.filter(hasRealVisual).slice(0, 3);
const rest = others.filter((n) => !side.includes(n));
const second = rest.slice(0, 3);
const latest = rest.slice(3, HOME_MAIN - 4);
const hasMore = news.length > HOME_MAIN;
const shown = new Set([lead, ...side, ...second, ...latest].filter(Boolean).map((n) => n.id));

// Gündem: son 3 günde birden fazla haberde geçen etiketler
const tags = await getTags();
const recent = news.filter((n) => n.data.date.valueOf() > Date.now() - 3 * 86400e3);
const tagCount = new Map();
for (const n of recent) for (const s of new Set(n.data.tags.map(tagSlug))) if (s) tagCount.set(s, (tagCount.get(s) ?? 0) + 1);
const trending = lang === 'en' ? [] : [...tagCount.entries()].filter(([, c]) => c > 1).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([s]) => tags.get(s)).filter(Boolean);

// Kategori blokları: son 30 günde en az 3 gösterilmemiş haberi olan kategoriler (1 büyük + 2-3 küçük), en yeni haberine göre
const monthAgo = Date.now() - 30 * 86400e3;
// İş kolları şeridi (yalnızca rehberi olan sektörler)
const sectorSet = new Set((await getCollection('rehberler', (g) => !g.data.draft && g.data.sector)).map((g) => g.data.sector));
const liveSectors = SECTORS.filter((s) => sectorSet.has(s.slug));
const blocks = CATEGORIES.map((c) => ({
  cat: c,
  items: news.filter((n) => n.data.category === c.slug && n.data.date.valueOf() > monthAgo && !shown.has(n.id)).slice(0, 4),
})).filter((b) => b.items.length >= 3).sort((a, b) => b.items[0].data.date - a.items[0].data.date).slice(0, 3);

const heroV = spreadVisuals([lead, ...side].filter(Boolean), { largeFirst: true, noIllus: true });
// Manşet fotoğrafı sayfanın en büyük görseli (LCP): <head> içinde erkenden yüklenir
const leadV = lead ? heroV.get(lead.id) : undefined;
const leadPhoto = leadV?.kind === 'photo' ? (leadV.n === 2 ? lead.data.photo2 : lead.data.photo) : undefined;
const preloadImage = leadPhoto ? photoSet(leadPhoto, 820, 420) : undefined;
const secondV = spreadVisuals(second);
const listV = spreadVisuals(latest);
---
<Base preloadImage={preloadImage}>
  {lead ? (
    <div class="home">
      <section class="hero" aria-label={T('Manşet', 'Top story')}>
        <a class="lead" href={newsUrl(lead)}>
          <div class="imgbox">
            <Visual entry={lead} choice={heroV.get(lead.id)} w={820} h={420} eager />
            <span class="badge">{cn(lead.data.category)}</span>
          </div>
          <h1>{lead.data.title}</h1>
          <p>{lead.data.spot}</p>
          <span class="meta"><Time date={lead.data.date} /></span>
        </a>
        {side.length > 0 && (
          <div class="side">
            {side.map((n, i) => (
              <a href={newsUrl(n)}>
                {i === 0 && <Visual entry={n} choice={heroV.get(n.id)} w={420} h={170} />}
                <div>
                  <span class="cat">{cn(n.data.category)}</span>
                  <h2>{n.data.title}</h2>
                  <span class="meta"><Time date={n.data.date} /></span>
                </div>
                {i > 0 && <Visual entry={n} choice={heroV.get(n.id)} w={112} h={84} credit={false} />}
              </a>
            ))}
          </div>
        )}
      </section>

      {trending.length > 0 && (
        <nav class="tags" aria-label="Gündemdeki konular">
          <strong>Gündemde:</strong>
          {trending.map((t) => <a class="tag" href={tagUrl(t.name)}>#{t.name}</a>)}
        </nav>
      )}

      {second.length > 0 && (
        <section class="second" aria-labelledby="second-h">
          <h2 id="second-h" class="sr-only">{T('Öne çıkanlar', 'Featured')}</h2>
          {second.map((n) => (
            <a class="card" href={newsUrl(n)}>
              <Visual entry={n} choice={secondV.get(n.id)} w={440} h={240} />
              <span class="cat">{cn(n.data.category)}</span>
              <h3>{n.data.title}</h3>
              <p>{n.data.spot}</p>
              <span class="meta"><Time date={n.data.date} /></span>
            </a>
          ))}
        </section>
      )}

      <div class="cols">
        <section class="main" aria-labelledby="latest-h">
          <div class="sechead"><h2 id="latest-h">{T('Son haberler', 'Latest news')}</h2></div>
          {latest.length ? latest.map((n) => <NewsRow item={n} choice={listV.get(n.id)} />) : <p class="empty">{T('Yeni haberler bir sonraki güncellemede burada olacak.', 'New stories will appear here after the next update.')}</p>}
          {hasMore && <div class="pager"><span></span><a href={url('/sayfa/2/')}>{T('Daha eski haberler →', 'Older news →')}</a></div>}
        </section>
        <Sidebar exclude={[...shown]} />
      </div>

      {liveSectors.length > 0 && (
        <section class="sector-strip" aria-labelledby="sec-h">
          <div class="sechead"><h2 id="sec-h">{T('İş kollarında yapay zeka', 'AI by industry')}</h2><a class="more-link" href={url('/sektor/')}>{T('Tümü →', 'All →')}</a></div>
          <ul>{liveSectors.map((s) => <li><a href={url(`/sektor/${s.slug}/`)}>{lang === 'en' ? s.en.title : s.title}</a></li>)}</ul>
        </section>
      )}

      {blocks.map((b) => {
        const v = spreadVisuals(b.items, { largeFirst: true });
        const [big, ...small] = b.items;
        return (
          <section class="catblock" aria-labelledby={`cb-${b.cat.slug}`}>
            <div class="sechead"><h2 id={`cb-${b.cat.slug}`}>{cn(b.cat.slug)}</h2><a class="more-link" href={catUrl(b.cat.slug)} aria-label={T(`Tüm ${cn(b.cat.slug)} haberleri`, `All ${cn(b.cat.slug)} news`)}>{T('Tümü →', 'All →')}</a></div>
            <div class="catblock-grid">
              <a class="card big" href={newsUrl(big)}>
                <Visual entry={big} choice={v.get(big.id)} w={640} h={340} />
                <h3>{big.data.title}</h3>
                <p>{big.data.spot}</p>
                <span class="meta"><Time date={big.data.date} /></span>
              </a>
              <div class="catblock-list">
                {small.map((n) => (
                  <a class="mini" href={newsUrl(n)}>
                    <Visual entry={n} choice={v.get(n.id)} w={120} h={80} credit={false} />
                    <div><h3>{n.data.title}</h3><span class="meta"><Time date={n.data.date} /></span></div>
                  </a>
                ))}
              </div>
            </div>
          </section>
        );
      })}
    </div>
  ) : (
    <p class="empty">{T('Henüz haber yok. İlk otomatik güncellemeden sonra haberler burada görünecek.', 'No stories yet.')}</p>
  )}
</Base>
