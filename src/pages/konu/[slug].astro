---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getNews, spreadVisuals, url } from '../../lib/news.js';
import { entityIndex } from '../../lib/entities.js';
import { brandOf } from '../../lib/brands.js';
import { i18n, locNewsList } from '../../i18n/index.js';

export async function getStaticPaths() {
  const idx = entityIndex(await getNews());
  return [...idx.values()].map(({ entity, items }) => ({ params: { slug: entity.slug }, props: { entity, items } }));
}
const L = await i18n(Astro);
const { lang, T, S } = L;
const e = { ...Astro.props.entity, about: S(`entity.${Astro.props.entity.slug}.about`, Astro.props.entity.about) };
const items = locNewsList(Astro.props.items, lang, L.m);
const rowV = spreadVisuals(items);
const brand = brandOf(e.brand);
const kind = e.type === 'person' ? T('Kişi', 'Person') : T('Şirket', 'Company');
const pageUrl = new URL(url(`/konu/${e.slug}/`), Astro.site).href;
const jsonLd = [
  { '@type': 'CollectionPage', '@id': `${pageUrl}#page`, name: T(`${e.name} haberleri`, `${e.name} news`), inLanguage: L.locale, about: { '@id': `${pageUrl}#konu` } },
  e.type === 'person'
    ? { '@type': 'Person', '@id': `${pageUrl}#konu`, name: e.name, description: e.about, ...(e.org ? { affiliation: { '@type': 'Organization', name: e.org } } : {}) }
    : { '@type': 'Organization', '@id': `${pageUrl}#konu`, name: e.name, description: e.about, ...(e.url ? { url: e.url } : {}) },
];
import { brandLogo } from '../../lib/brand-logos.js';
---
<Base title={T(`${e.name} haberleri`, `${e.name} news and updates`)} description={T(`${e.about} ${e.name} ile ilgili ${items.length} haber.`, `${e.about} ${items.length} stories about ${e.name}.`).slice(0, 300)}
  noindex={items.length < 2} jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Şirketler ve kişiler', 'Companies and people'), path: '/konular/' }, { name: e.name, path: `/konu/${e.slug}/` }]}>
  <div class="cols flush">
    <section class="main" aria-labelledby="h">
      <nav class="crumb" aria-label={T('Konum', 'Breadcrumb')}><a href={url('/')}>{T('Ana sayfa', 'Home')}</a><span aria-hidden="true">/</span><a href={url('/konular/')}>{T('Şirketler ve kişiler', 'Companies and people')}</a></nav>
      <header class="entity-head">
        {brand ? (
          brandLogo(e.brand) ? <img class="entity-logo entity-img" src={url(brandLogo(e.brand))} alt={T(`${brand.name} logosu`, `${brand.name} logo`)} width="96" height="96" /> : (
          <span class:list={["entity-logo brandcard", `b-${e.brand}`, { wordmark: !brand.path }]} role="img" aria-label={T(`${brand.name} logosu`, `${brand.name} logo`)}>
            {brand.path ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg> : <span class="bn">{brand.name}</span>}
          </span>)
        ) : (
          <span class="entity-logo entity-initials" aria-hidden="true">{e.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}</span>
        )}
        <div>
          <span class="cat">{kind}{e.org ? ` · ${e.org}` : ''}</span>
          <h1 id="h" class="page-h">{e.name}</h1>
          <p class="entity-about">{e.about}</p>
          {e.url && <a class="meta entity-site" href={e.url} target="_blank" rel="noopener">{new URL(e.url).hostname.replace(/^www\./, '')} ↗</a>}
        </div>
      </header>
      <div class="sechead"><h2>{T(`${e.name} haberleri`, `${e.name} news`)}</h2><span class="meta">{items.length} {T('haber', 'stories')}</span></div>
      {items.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} />)}
    </section>
    <Sidebar exclude={items.map((n) => n.id)} />
  </div>
</Base>
