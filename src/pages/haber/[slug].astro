---
import { render } from 'astro:content';
import { correctionsFor } from '../../lib/corrections.js';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import Time from '../../components/Time.astro';
import { IMAGES } from '../../lib/site.js';
import { tagUrl, getNews, slugOf, newsUrl, spreadVisuals, defaultVisual, ogImageFor, cardFor, withUtm, photoSource, catName, catUrl, url, readingMinutes, hostOf, photoSrc, formatDate } from '../../lib/news.js';
import { brandOf } from '../../lib/brands.js';
import { entitiesOf } from '../../lib/entities.js';
import { storyOf, storyIndex } from '../../lib/stories.js';
import Visual from '../../components/Visual.astro';
import { i18n, locNews, locNewsList, locGuide } from '../../i18n/index.js';
import { getCollection } from 'astro:content';
import { moreFor } from '../../lib/related.js';
import { toolBySlug, compareSlug, vsTr } from '../../lib/tools.js';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const L = await i18n(Astro);
const { lang, T, S, u } = L;
const entry = locNews(Astro.props.entry, lang, L.m);
const d = entry.data;
const { Content } = await render(entry.en ?? entry);
const all = locNewsList(await getNews(), lang, L.m);
const cat = S(`cat.${d.category}.name`, catName(d.category));
const related = all
  .filter((n) => n.id !== entry.id)
  .map((n) => ({ n, score: (n.data.category === d.category ? 2 : 0) + n.data.tags.filter((t) => d.tags.includes(t)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.n.data.date.valueOf() - a.n.data.date.valueOf())
  .slice(0, 3)
  .map((x) => x.n);

// İlgili haberler: bu haberin kendi çizimiyle ve birbirleriyle aynı görünmesin
const relV = spreadVisuals([entry, ...related]);
const main = defaultVisual(entry, true);
const mainPhoto = main.kind === 'photo' ? (main.pool ?? (main.n === 2 ? d.photo2 : d.photo)) : undefined;
const ents = entitiesOf(entry);
// Daha fazlası: haberden kalıcı sayfalara (sektör, rehber, karşılaştırma, takipçi) bağlantı. Eşleştirme Türkçe metinle.
const trGuides = await getCollection('rehberler', (g) => !g.data.draft);
const more = moreFor(Astro.props.entry, trGuides);
const moreGuides = more.guides.map((g) => locGuide(g, lang, L.m)).filter(Boolean);
const moreLinks = [
  ...(more.sector ? [{ href: u(`/sektor/${more.sector.slug}/`), label: lang === 'en' ? more.sector.en.title : more.sector.title, kind: T('Sektör', 'Industry') }] : []),
  ...moreGuides.map((g) => ({ href: u(`/rehber/${g.id}/`), label: g.data.title, kind: T('Rehber', 'Guide') })),
  ...(more.comparison ? [{ href: u(`/karsilastir/${compareSlug(more.comparison[0], more.comparison[1])}/`), label: T(vsTr(toolBySlug(more.comparison[0]), toolBySlug(more.comparison[1])), `${toolBySlug(more.comparison[0]).name} vs ${toolBySlug(more.comparison[1]).name}`), kind: T('Karşılaştırma', 'Comparison') }] : []),
  ...(more.deal ? [{ href: u('/yatirimlar/'), label: T('Yapay zeka yatırımları ve satın almaları', 'AI funding and acquisitions tracker'), kind: T('Takipçi', 'Tracker') }] : []),
  ...(more.report ? [{ href: u('/raporlar/'), label: T('Yapay zeka raporlarından öne çıkanlar', 'Key findings from AI reports'), kind: T('Raporlar', 'Reports') }] : []),
].slice(0, 5);
// Etiketler: "Bu haberde" bölümünde zaten bağlanan şirket ve kişileri tekrar etiket olarak gösterme
const norm = (s) => String(s).toLocaleLowerCase('tr').replace(/[^\p{L}\p{N}]/gu, '');
const entNames = new Set(ents.map((e) => norm(e.name)));
const tags = d.tags.filter((t) => !entNames.has(norm(t)));
const story = storyOf(entry);
const storyItems = story ? storyIndex(all).get(story.slug)?.items ?? [] : [];
const og = ogImageFor(entry);
const pageUrl = new URL(u(`/haber/${slugOf(entry)}/`), Astro.site).href;
// Google haber görseli için üç oran (16:9, 4:3, 1:1), en az 1200px; fotoğraf yoksa paylaşım görseli
const card = cardFor(entry);
const ldImages = [
  ...(d.photo ? [photoSrc(d.photo, 1200, 675), photoSrc(d.photo, 1200, 900), photoSrc(d.photo, 1200, 1200)] : []),
  ...(card || !d.photo ? [new URL(og, Astro.site).href] : []),
];
const fixes = correctionsFor(slugOf(entry));
const lastFix = fixes.at(-1);
const jsonLd = {
  '@type': 'NewsArticle',
  '@id': `${pageUrl}#article`,
  headline: d.title.length > 110 ? d.title.slice(0, 109) + '…' : d.title,
  description: d.spot,
  datePublished: d.date.toISOString(),
  dateModified: lastFix ? new Date(`${lastFix.date}T12:00:00+03:00`).toISOString() : d.date.toISOString(),
  ...(fixes.length ? { correction: fixes.map((c) => ({ '@type': 'CorrectionComment', datePublished: c.date, text: lang === 'en' ? c.en ?? c.tr : c.tr })) } : {}),
  inLanguage: L.locale,
  image: ldImages,
  author: { '@type': 'Organization', name: d.author, url: new URL(u('/hakkimizda/'), Astro.site).href },
  publisher: { '@id': new URL(url('/#organization'), Astro.site).href },
  isPartOf: { '@id': new URL(url('/#website'), Astro.site).href },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  articleSection: cat,
  ...(lang === 'tr' ? { keywords: d.tags.join(', ') } : {}),
  wordCount: entry.body.split(/\s+/).filter(Boolean).length,
  isAccessibleForFree: true,
  citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
};
const crumbs = [{ name: 'Ana sayfa', path: '/' }, { name: cat, path: `/kategori/${d.category}/` }, { name: d.title, path: `/haber/${slugOf(entry)}/` }];
---
<Base title={d.title} description={d.spot} ogImage={og} ogType="article" currentCat={d.category} jsonLd={jsonLd} breadcrumbs={crumbs}
  article={{ published: d.date, section: cat, tags: lang === 'tr' ? d.tags : [] }}>
  <div class="cols flush gap-wide">
    <article class="article" data-pagefind-body data-pagefind-filter={`${T('Kategori', 'Section')}:${cat}`} data-pagefind-meta={`date:${formatDate(d.date, false, L.locale)}`}>
      <nav class="crumb" aria-label={T('Konum', 'Breadcrumb')} data-pagefind-ignore><a href={u('/')}>{T('Ana sayfa', 'Home')}</a><span aria-hidden="true">/</span><a href={u(`/kategori/${d.category}/`)}>{cat}</a></nav>
      <span class="badge" data-pagefind-ignore>{cat}</span>{d.format === 'kisa' && <span class="badge badge-short" data-pagefind-ignore>{T('Kısa not', 'Brief')}</span>}
      <h1 data-pagefind-meta="title">{d.title}</h1>
      <p class="spot">{d.spot}</p>
      {story && storyItems.length >= 2 && (
        <aside class="story-band" aria-label={T('Gelişen hikâye', 'Developing story')} data-pagefind-ignore>
          <div><span class="cat">{T('Gelişen hikâye', 'Developing story')} · {T(`${storyItems.findIndex((n) => n.id === entry.id) + 1}. gelişme / ${storyItems.length}`, `update ${storyItems.findIndex((n) => n.id === entry.id) + 1} of ${storyItems.length}`)}</span><strong>{S(`story.${story.slug}.title`, story.title)}</strong></div>
          <a class="more" href={u(`/gelisme/${story.slug}/`)}>{T('Olayların gelişimi →', 'Full timeline →')}</a>
        </aside>
      )}
      <div class="byline">
        <span class="meta byline-meta" data-pagefind-ignore><Time date={d.date} /> · {readingMinutes(entry.body)} {T('dk okuma', 'min read')}</span>
        <div class="share" data-pagefind-ignore>
          <button type="button" class="share-native" data-share-native data-title={d.title} hidden>{T('Paylaş', 'Share')}</button>
          <a class="tag" href={`https://x.com/intent/post?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">{T("X'te paylaş", 'Share on X')}</a>
          <a class="tag" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a class="tag" href={`https://wa.me/?text=${encodeURIComponent(`${d.title} ${pageUrl}`)}`} target="_blank" rel="noopener">WhatsApp</a>
          <button type="button" data-share-ig data-title={d.title}>Instagram</button>
          <button type="button" data-copy>{T('Bağlantıyı kopyala', 'Copy link')}</button>
          <a class="tag pref-src" href="https://www.google.com/preferences/source?q=yzgundemi.com" target="_blank" rel="noopener" title={T('Google aramalarında YZ Gündemi haberlerini daha sık görün', 'See more YZ Gündemi stories in Google Search')}>{T("Google'da tercih et", 'Prefer on Google')}</a>
          <span class="share-note" role="status" aria-live="polite"></span>
        </div>
      </div>

      {main.kind !== 'none' && (
        <figure data-pagefind-ignore>
          <Visual entry={entry} choice={main} w={780} h={420} eager credit={false} />
          <figcaption>
            {mainPhoto ? (
              <>{T('Fotoğraf', 'Photo')}: <a href={withUtm(mainPhoto.authorUrl)} target="_blank" rel="noopener">{mainPhoto.author}</a> / <a href={withUtm(photoSource(mainPhoto).url)} target="_blank" rel="noopener">{photoSource(mainPhoto).name}</a> · {T('Temsili görseldir', 'Illustrative image')}</>
            ) : (
              <>{T(`${brandOf(main.b ?? d.brand)?.name} logosu. Logolar sahiplerinin tescilli markalarıdır.`, `${brandOf(main.b ?? d.brand)?.name} logo. Logos are registered trademarks of their owners.`)}</>
            )}
          </figcaption>
        </figure>
      )}

      {d.keyPoints && d.keyPoints.length >= 2 && (
        <aside class="why guide-summary key-points" aria-label={T('Kısaca', 'Key points')}>
          <strong>{T('Kısaca', 'Key points')}</strong>
          <ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul>
        </aside>
      )}

      {d.byNumbers && d.byNumbers.length >= 2 && (
        <aside class="by-numbers" aria-label={T('Rakamlarla', 'By the numbers')}>
          <span class="cat">{T('Rakamlarla', 'By the numbers')}</span>
          <dl>{d.byNumbers.map((b) => <div><dt>{b.value}</dt><dd>{b.label}</dd></div>)}</dl>
        </aside>
      )}

      <div class="prose"><Content /></div>
      {d.newTool && (
        <aside class="why new-tool" aria-label={T('Yeni araç', 'New tool')}>
          <strong>{T('Yeni araç', 'New tool')}: {d.newTool.name}</strong>
          {d.newTool.what && <p>{d.newTool.what}</p>}
          <p><a href={d.newTool.url} rel="noopener">{T(`${d.newTool.name} sitesine git ↗`, `Visit ${d.newTool.name} ↗`)}</a> · <a href={u('/yeni-araclar/')}>{T('Diğer yeni araçlar', 'More new tools')}</a></p>
        </aside>
      )}

      {(d.whyItMatters || d.turkeyAngle || d.whatsNext) && (
        <aside class="why" aria-label={T('Bu ne anlama geliyor', 'Why it matters')}>
          <span class="cat">{T('Bu ne anlama geliyor?', 'Why it matters')}</span>
          {d.whyItMatters && <p>{d.whyItMatters}</p>}
          {d.whatsNext && (
            <div class="why-tr why-next">
              <span class="why-tr-label">{T('Sırada ne var?', 'What’s next')}</span>
              <p>{d.whatsNext}</p>
            </div>
          )}
          {d.turkeyAngle && (
            <div class="why-tr">
              <span class="why-tr-label">{T('Türkiye açısından', 'The Turkey angle')}</span>
              <p>{d.turkeyAngle}</p>
            </div>
          )}
        </aside>
      )}

      {fixes.length > 0 && (
        <aside class="correction" aria-labelledby="fix-h">
          <h2 id="fix-h">{T('Düzeltme', 'Correction')}</h2>
          {fixes.map((c) => <p><time datetime={c.date}>{formatDate(new Date(`${c.date}T12:00:00+03:00`), false, L.locale)}</time>: {lang === 'en' ? c.en ?? c.tr : c.tr}</p>)}
          <p class="meta"><a href={u('/duzeltmeler/')}>{T('Tüm düzeltmeler', 'All corrections')}</a></p>
        </aside>
      )}

      {moreLinks.length > 0 && (
        <aside class="more-box" aria-labelledby="more-h" data-pagefind-ignore>
          <h2 id="more-h">{T('Konuyu derinlemesine okuyun', 'Go deeper')}</h2>
          <ul>{moreLinks.map((m) => <li><span class="more-kind">{m.kind}</span><a href={m.href}>{m.label}</a></li>)}</ul>
        </aside>
      )}

      <section class="sources" aria-labelledby="src-h" data-pagefind-ignore>
        <h2 id="src-h">{d.sources.length === 1 ? T('Kaynak', 'Source') : T('Kaynaklar', 'Sources')}</h2>
        <ul>
          {d.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a>
              <span class="host"> · {s.publisher ?? hostOf(s.url)}</span>
            </li>
          ))}
        </ul>
        {d.generated
          ? <p class="ai-note">{d.sources.length === 1 ? T('Bu haber, yukarıdaki kaynaktan yapay zeka desteğiyle derlenmiştir.', 'This article was compiled with AI assistance from the source above') : T('Bu haber, yukarıdaki kaynaklardan yapay zeka desteğiyle derlenmiştir.', 'This article was compiled with AI assistance from the sources above')}{lang === 'en' && ' and translated from our Turkish edition.'}<br /><a href={`${u('/hakkimizda/')}#how-h`}>{T('Haberlerimizi nasıl hazırlıyoruz?', 'How we make our stories')}</a> {T('Bir hata görürseniz', 'Spotted an error?')} <a href={`${u('/hata-bildir/')}?haber=${slugOf(entry)}`}>{T('bize bildirin', 'Let us know')}</a>.</p>
          : <p class="ai-note">{T('Bir hata görürseniz', 'Spotted an error?')} <a href={`${u('/hata-bildir/')}?haber=${slugOf(entry)}`}>{T('bize bildirin', 'Let us know')}</a>.</p>}
      </section>

      {ents.length > 0 && (
        <nav class="entity-links" aria-label={T('Bu haberde geçen şirketler ve kişiler', 'Companies and people in this story')} data-pagefind-ignore>
          <strong>{T('Bu haberde:', 'In this story:')}</strong>
          {ents.map((e) => <a class="tag" href={u(`/konu/${e.slug}/`)}>{e.name}</a>)}
        </nav>
      )}
      {lang === 'tr' && tags.length > 0 && <div class="atags" data-pagefind-ignore>{tags.map((t) => <a class="tag" href={tagUrl(t)}>#{t}</a>)}</div>}

      {related.length > 0 && (
        <section class="related" aria-labelledby="rel-h" data-pagefind-ignore>
          <div class="sechead sm"><h2 id="rel-h">{T('İlgili haberler', 'Related news')}</h2></div>
          <div class="grid4">
            {related.map((n) => (
              <a href={u(`/haber/${slugOf(n)}/`)}>
                <Visual entry={n} choice={relV.get(n.id)} w={300} h={130} />
                <h3>{n.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
    <Sidebar exclude={[entry.id, ...related.map((n) => n.id)]} latest={8} id="a" />
  </div>
</Base>
