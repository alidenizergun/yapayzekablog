---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import Time from '../../components/Time.astro';
import { IMAGES } from '../../lib/site.js';
import { tagUrl, getNews, slugOf, newsUrl, spreadVisuals, defaultVisual, ogImageFor, withUtm, catName, catUrl, url, readingMinutes, hostOf, photoSrc } from '../../lib/news.js';
import { brandOf } from '../../lib/brands.js';
import Visual from '../../components/Visual.astro';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const all = await getNews();
const related = all
  .filter((n) => n.id !== entry.id)
  .map((n) => ({ n, score: (n.data.category === d.category ? 2 : 0) + n.data.tags.filter((t) => d.tags.includes(t)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.n.data.date.valueOf() - a.n.data.date.valueOf())
  .slice(0, 3)
  .map((x) => x.n);

// İlgili haberler: bu haberin kendi çizimiyle ve birbirleriyle aynı görünmesin
const relV = spreadVisuals([entry, ...related]);
const main = defaultVisual(entry, true);
const og = ogImageFor(entry);
const pageUrl = new URL(newsUrl(entry), Astro.site).href;
// Google haber görseli için üç oran (16:9, 4:3, 1:1), en az 1200px; fotoğraf yoksa paylaşım görseli
const ldImages = d.photo
  ? [photoSrc(d.photo, 1200, 675), photoSrc(d.photo, 1200, 900), photoSrc(d.photo, 1200, 1200)]
  : [new URL(og, Astro.site).href];
const jsonLd = {
  '@type': 'NewsArticle',
  '@id': `${pageUrl}#article`,
  headline: d.title.length > 110 ? d.title.slice(0, 109) + '…' : d.title,
  description: d.spot,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  inLanguage: 'tr-TR',
  image: ldImages,
  author: { '@type': 'Organization', name: d.author, url: new URL(url('/hakkimizda/'), Astro.site).href },
  publisher: { '@id': new URL(url('/#organization'), Astro.site).href },
  isPartOf: { '@id': new URL(url('/#website'), Astro.site).href },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  articleSection: catName(d.category),
  keywords: d.tags.join(', '),
  wordCount: entry.body.split(/\s+/).filter(Boolean).length,
  isAccessibleForFree: true,
  citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
};
const crumbs = [{ name: 'Ana sayfa', path: '/' }, { name: catName(d.category), path: `/kategori/${d.category}/` }, { name: d.title, path: `/haber/${slugOf(entry)}/` }];
---
<Base title={d.title} description={d.spot} ogImage={og} ogType="article" currentCat={d.category} jsonLd={jsonLd} breadcrumbs={crumbs}
  article={{ published: d.date, section: catName(d.category), tags: d.tags }}>
  <div class="cols" style="margin-top:0;gap:56px">
    <article class="article">
      <nav class="crumb" aria-label="Konum"><a href={url('/')}>Ana sayfa</a><span aria-hidden="true">/</span><a href={catUrl(d.category)}>{catName(d.category)}</a></nav>
      <span class="badge">{catName(d.category)}</span>
      <h1>{d.title}</h1>
      <p class="spot">{d.spot}</p>
      <div class="byline">
        <div class="author">
          <div class="avatar" aria-hidden="true">N</div>
          <div style="display:flex;flex-direction:column">
            <span style="font-weight:600;font-size:15px">{d.author}</span>
            <span class="meta"><Time date={d.date} /> · {readingMinutes(entry.body)} dk okuma</span>
          </div>
        </div>
        <div class="share">
          <a class="tag" href={`https://x.com/intent/post?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">X'te paylaş</a>
          <a class="tag" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">LinkedIn</a>
          <a class="tag" href={`https://wa.me/?text=${encodeURIComponent(`${d.title} ${pageUrl}`)}`} target="_blank" rel="noopener">WhatsApp</a>
          <button type="button" data-share-ig data-title={d.title}>Instagram</button>
          <button type="button" data-copy>Bağlantıyı kopyala</button>
          <span class="share-note" role="status" aria-live="polite"></span>
        </div>
      </div>

      <figure>
        <Visual entry={entry} choice={main} w={780} h={420} eager credit={false} />
        <figcaption>
          {main.kind === 'photo' && d.photo ? (
            <>Fotoğraf: <a href={withUtm(d.photo.authorUrl)} target="_blank" rel="noopener">{d.photo.author}</a> / <a href={withUtm('https://unsplash.com/')} target="_blank" rel="noopener">Unsplash</a> · Temsili görseldir</>
          ) : main.kind === 'brand' ? (
            <>{brandOf(d.brand)?.name} logosu. Logolar sahiplerinin tescilli markalarıdır.</>
          ) : (
            <>İllüstrasyon: YZ Gündemi</>
          )}
        </figcaption>
      </figure>

      <div class="prose"><Content /></div>

      {d.whyItMatters && (
        <aside class="why" aria-label="Bu ne anlama geliyor">
          <span class="cat">Bu ne anlama geliyor?</span>
          <p>{d.whyItMatters}</p>
        </aside>
      )}

      <section class="sources" aria-labelledby="src-h">
        <h2 id="src-h">Kaynaklar</h2>
        <ol>
          {d.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a>
              <span class="host"> · {s.publisher ?? hostOf(s.url)}</span>
            </li>
          ))}
        </ol>
        {d.generated
          ? <p class="ai-note">Bu haber, yukarıdaki kaynaklardan yapay zeka desteğiyle derlenmiştir. Bir hata görürseniz <a href={`${url('/hata-bildir/')}?haber=${slugOf(entry)}`}>bize bildirin</a>.</p>
          : <p class="ai-note">Bir hata görürseniz <a href={`${url('/hata-bildir/')}?haber=${slugOf(entry)}`}>bize bildirin</a>.</p>}
      </section>

      {d.tags.length > 0 && <div class="atags">{d.tags.map((t) => <a class="tag" href={tagUrl(t)}>#{t}</a>)}</div>}

      {related.length > 0 && (
        <section class="related" aria-labelledby="rel-h">
          <div class="sechead sm"><h2 id="rel-h">İlgili Haberler</h2></div>
          <div class="grid4">
            {related.map((n) => (
              <a href={newsUrl(n)}>
                <Visual entry={n} choice={relV.get(n.id)} w={300} h={130} />
                <h3>{n.data.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
    <Sidebar exclude={[entry.id, ...related.map((n) => n.id)]} latest={8} id="a" />
  </div>
</Base>
