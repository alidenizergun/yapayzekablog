---
import Base from '../../layouts/Base.astro';
import { COMPARISONS, toolBySlug, compareSlug, freeLabel, trDate, toolUrl, catName, vsTr, withQ } from '../../lib/tools.js';
import { usdTry, fmtUsd, fmtTry } from '../../lib/fx.js';
import { url } from '../../lib/news.js';
import { i18n, locTool, toolCat, freeL, dateL, usdL, tryL } from '../../i18n/index.js';

export function getStaticPaths() {
  return COMPARISONS.map(([a, b, answer]) => ({ params: { slug: compareSlug(a, b) }, props: { a: toolBySlug(a), b: toolBySlug(b), answer } }));
}
const L = await i18n(Astro);
const { lang, T, S } = L;
const a = locTool(Astro.props.a, lang), b = locTool(Astro.props.b, lang);
const answer = S(`cmp.${a.slug}-vs-${b.slug}`, Astro.props.answer);
const vs = (x, y) => T(vsTr(x, y), `${x.name} vs ${y.name}`);
const fx = await usdTry();
const both = [a, b];
const priceCell = (t) => t.price?.from ? `${t.price.plan}: ${usdL(t.price.from, lang)}/${T('ay', 'mo')}${fx ? ` (${tryL(t.price.from, fx, lang)})` : ''}` : T('Resmi sayfada', 'See official site');
const rows = [
  [T('Şirket', 'Company'), (t) => t.company],
  [T('Kategori', 'Category'), (t) => t.cats.map((c) => toolCat(c, lang)).join(', ')],
  [T('Ücretsiz kullanım', 'Free use'), (t) => (t.free ? freeL(t.free, lang) : T('Doğrulanmadı', 'Not verified'))],
  [T('Ücretli başlangıç', 'Paid plans from'), priceCell],
  [T('Türkçe', 'Turkish'), (t) => (t.turkish ? T('Kullanılabiliyor', 'Supported') : T('Doğrulanmadı', 'Not verified'))],
  [T('Platformlar', 'Platforms'), (t) => t.platforms.join(', ')],
];
const others = COMPARISONS.filter(([x, y]) => compareSlug(x, y) !== compareSlug(a.slug, b.slug)).slice(0, 8);
const faq = [
  [T(`${withQ(a)} ${withQ(b)} daha iyi?`, `Which is better, ${a.name} or ${b.name}?`), answer],
  [T(`${a.name} ve ${b.name} ücretsiz mi?`, `Are ${a.name} and ${b.name} free?`), both.map((t) => `${t.name}: ${t.free ? freeL(t.free, lang).toLocaleLowerCase(lang) : T('doğrulanmadı', 'not verified')}`).join('. ') + '.'],
];
const jsonLd = { '@type': 'FAQPage', mainEntity: faq.map(([q, ans]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: ans } })) };
---
<Base title={T(`${vsTr(a, b)} Fiyat, özellik ve kullanım karşılaştırması`, `${a.name} vs ${b.name}: pricing, features and which to choose`)} description={T(`${a.name} ve ${b.name} karşılaştırması: fiyatlar, ücretsiz planlar, Türkçe desteği, güçlü yanlar ve hangisinin kimin için uygun olduğu.`, `${a.name} vs ${b.name}: pricing, free plans, strengths and who each one is for.`)}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Yapay zeka araçları', 'AI tools'), path: '/arac/' }, { name: T('Karşılaştırmalar', 'Comparisons'), path: '/karsilastir/' }, { name: vs(a, b), path: `/karsilastir/${compareSlug(a.slug, b.slug)}/` }]}>
  <section class="deals compare" data-pagefind-body>
    <nav class="crumb" aria-label={T('Konum', 'Breadcrumb')} data-pagefind-ignore><a href={url('/')}>{T('Ana sayfa', 'Home')}</a><span aria-hidden="true">/</span><a href={url('/arac/')}>{T('Yapay zeka araçları', 'AI tools')}</a><span aria-hidden="true">/</span><a href={url('/karsilastir/')}>{T('Karşılaştırmalar', 'Comparisons')}</a></nav>
    <span class="cat">{T('Karşılaştırma', 'Comparison')}</span>
    <h1 class="page-h">{vs(a, b)}</h1>
    <aside class="why guide-summary" aria-label={T('Kısa cevap', 'Short answer')}><strong>{T('Kısa cevap', 'Short answer')}</strong><p>{answer}</p></aside>

    <div class="deal-table-wrap">
      <table class="deal-table compare-table">
        <thead><tr><th scope="col"><span class="sr-only">{T('Özellik', 'Feature')}</span></th>{both.map((t) => <th scope="col"><a href={url(toolUrl(t.slug))}>{t.name}</a></th>)}</tr></thead>
        <tbody>{rows.map(([label, f]) => <tr><th scope="row">{label}</th>{both.map((t) => <td>{f(t)}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="price-src">{T('Fiyat kaynakları', 'Price sources')}: {both.filter((t) => t.price).map((t, i) => <>{i > 0 && ' · '}<a href={t.price.source.url} rel="noopener">{t.price.source.label}</a> ({dateL(t.price.source.checked, lang)}{!t.price.source.official && T(', ikincil kaynak', ', secondary source')})</>)}. {fx && T(`TL karşılıkları TCMB kuruyla (${fx.date}); vergiler hariç. `, `Lira amounts at the TCMB rate (${fx.date}), excluding taxes. `)}{T('Satın almadan önce resmi sayfaları kontrol edin.', 'Check the official pages before you buy.')}</p>

    <div class="compare-cols">
      {both.map((t) => (
        <section aria-labelledby={`c-${t.slug}`}>
          <h2 id={`c-${t.slug}`}>{T(`${t.name} kimler için?`, `Who ${t.name} is for`)}</h2>
          <ul class="tool-list tool-good">{t.good.map((g) => <li>{g}</li>)}</ul>
          <h3>{T('Ne zaman uygun değil?', 'When to skip it')}</h3>
          <ul class="tool-list tool-bad">{t.notFor.map((g) => <li>{g}</li>)}</ul>
          <p><a href={url(toolUrl(t.slug))}>{T(`${t.name} fiyatları ve ayrıntılar →`, `${t.name} pricing and details →`)}</a></p>
        </section>
      ))}
    </div>

    <section class="models-faq" aria-labelledby="cf-h">
      <h2 id="cf-h">{T('Sık sorulanlar', 'FAQ')}</h2>
      {faq.map(([q, ans]) => <details><summary>{q}</summary><p>{ans}</p></details>)}
      {lang === 'en' ? <p>The best way to decide is to try both on a few real tasks from your own work. Our <a href={url('/rehber/hangi-yapay-zeka-modelini-secmeliyim/')}>guide to choosing a model</a> can help.</p> : <p>En doğru karar için iki aracı kendi işlerinizden birkaç örnekle deneyin. <a href={url('/rehber/hangi-yapay-zeka-modelini-secmeliyim/')}>Model seçme rehberimiz</a> bu konuda yardımcı olur.</p>}
    </section>

    <h2 class="ev-h">{T('Diğer karşılaştırmalar', 'More comparisons')}</h2>
    <ul class="task-chips">{others.map(([x, y]) => <li><a href={url(`/karsilastir/${compareSlug(x, y)}/`)}>{vs(toolBySlug(x), toolBySlug(y))}</a></li>)}</ul>
  </section>
</Base>
