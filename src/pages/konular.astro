---
import Base from '../layouts/Base.astro';
import { getNews, url } from '../lib/news.js';
import { entityIndex } from '../lib/entities.js';
import { brandOf } from '../lib/brands.js';
import { i18n, locNewsList } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;

const idx = [...entityIndex(locNewsList(await getNews(), lang, L.m)).values()].sort((a, b) => b.items.length - a.items.length || a.entity.name.localeCompare(b.entity.name, 'tr'));
const groups = [
  { id: 'sirketler', title: T('Şirketler', 'Companies'), list: idx.filter((x) => x.entity.type === 'company') },
  { id: 'kisiler', title: T('Kişiler', 'People'), list: idx.filter((x) => x.entity.type === 'person') },
].filter((g) => g.list.length);
import { brandLogo } from '../lib/brand-logos.js';
---
<Base title={T('Şirketler ve kişiler', 'AI companies and people')} description={T('Yapay zeka gündemindeki şirketler ve kişiler: OpenAI, Anthropic, Nvidia, Google ve daha fazlası hakkında YZ Gündemi haberleri.', 'The companies and people shaping AI: news on OpenAI, Anthropic, Nvidia, Google and more.')}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Şirketler ve kişiler', 'Companies and people'), path: '/konular/' }]}>
  <section class="entities-page">
    <h1 class="page-h">{T('Şirketler ve kişiler', 'Companies and people')}</h1>
    <p class="spot">{T('Yapay zeka gündemindeki şirketler ve kişiler, haklarındaki son haberlerle.', 'The companies and people in AI news, with their latest stories.')}</p>
    {groups.map((g) => (
      <section class="entity-group" aria-labelledby={`g-${g.id}`}>
        <div class="sechead"><h2 id={`g-${g.id}`}>{g.title}</h2></div>
        <ul class="entity-grid">
          {g.list.map(({ entity: e, items }) => {
            const b = brandOf(e.brand);
            return (
              <li><a href={url(`/konu/${e.slug}/`)}>
                {b && brandLogo(e.brand) ? <img class="entity-logo sm entity-img" src={url(brandLogo(e.brand))} alt="" width="48" height="48" loading="lazy" /> : b ? (
                  <span class:list={["entity-logo sm brandcard", `b-${e.brand}`, { wordmark: !b.path }]} aria-hidden="true">{b.path ? <svg viewBox="0 0 24 24"><path d={b.path} /></svg> : <span class="bn">{b.name}</span>}</span>
                ) : <span class="entity-logo sm entity-initials" aria-hidden="true">{e.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('')}</span>}
                <span class="entity-name">{e.name}</span>
                <span class="meta">{items.length} {T('haber', 'stories')}</span>
              </a></li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
</Base>
