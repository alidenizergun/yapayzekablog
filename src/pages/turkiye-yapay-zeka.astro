---
import Base from '../layouts/Base.astro';
import NewsRow from '../components/NewsRow.astro';
import { YERLI_MODELS, STATUS_LABEL, TR_POLICY, TR_STATS, TR_ROUNDS, TR_CHECKED } from '../lib/turkiye.js';
import { trDate } from '../lib/tools.js';
import { EVENTS } from '../lib/events.js';
import { getNews, spreadVisuals, url } from '../lib/news.js';

const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const when = (d) => { const [y, m, day] = d.split('-').map(Number); return day ? `${day} ${MONTHS[m - 1]} ${y}` : `${MONTHS[m - 1]} ${y}`; };
const news = (await getNews()).filter((n) => n.data.category === 'turkiye' || n.data.turkeyAngle).slice(0, 6);
const rowV = spreadVisuals(news);
const policy = [...TR_POLICY].reverse();
const today = new Date(Date.now() + 3 * 3600e3).toISOString().slice(0, 10);
const nextEvents = EVENTS.filter((e) => e.end >= today).sort((a, b) => a.start.localeCompare(b.start)).slice(0, 3);
---
<Base title="Türkiye'de yapay zeka: yerli modeller, girişimler, düzenlemeler" description="Türkiye yapay zeka ekosistemi tek sayfada: yerli dil modelleri, girişim sayıları ve yatırımlar, Yapay Zeka Eylem Planı ve kanun teklifleri, KVKK rehberleri, etkinlikler ve haberler."
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: "Türkiye'de yapay zeka", path: '/turkiye-yapay-zeka/' }]}>
  <section class="deals tr-desk" data-pagefind-body>
    <span class="cat">Türkiye masası</span>
    <h1 class="page-h">Türkiye'de yapay zeka</h1>
    <p class="spot">Türkiye'nin yapay zeka ekosistemini tek sayfada izliyoruz: yerli modeller, girişimler ve yatırımlar, kamu politikaları ve düzenlemeler. Her bilgi kaynağına bağlıdır.</p>
    <p class="models-checked">Son kontrol: {trDate(TR_CHECKED)}</p>

    <aside class="by-numbers" aria-label="Rakamlarla">
      <span class="cat">Rakamlarla</span>
      <dl>{TR_STATS.map((s) => <div><dt>{s.value}</dt><dd>{s.label} · <a href={s.src[1]} rel="noopener">{s.src[0]}</a></dd></div>)}</dl>
      <p class="meta">Kaynakların "yapay zeka girişimi" tanımları farklı olduğu için sayılar birbirinden farklıdır.</p>
    </aside>

    <h2 class="ev-h">Yerli modeller</h2>
    <ul class="task-chips">{YERLI_MODELS.map((m) => <li><a href={url(`/yerli-yapay-zeka/#${m.slug}`)}>{m.name} · {STATUS_LABEL[m.status]}</a></li>)}</ul>
    <p><a class="more-link" href={url('/yerli-yapay-zeka/')}>Yerli modellerin durumu ve erişim yolları →</a></p>

    <h2 class="ev-h">Düzenleme ve kamu politikası</h2>
    <ol class="ev-list">
      {policy.map((p) => (
        <li class="ev">
          <div class="ev-date">{when(p.date)}</div>
          <div class="ev-body">
            <h3>{p.title}</h3>
            {p.note && <p>{p.note}</p>}
            <p class="meta">Kaynak: <a href={p.src[1]} rel="noopener">{p.src[0]}</a></p>
          </div>
        </li>
      ))}
    </ol>

    <h2 class="ev-h">Türk kurucuların 2026'daki öne çıkan yatırım turları</h2>
    <div class="deal-table-wrap">
      <table class="deal-table">
        <thead><tr><th scope="col">Girişim</th><th scope="col">Ne yapıyor</th><th scope="col">Tur</th><th scope="col">Yatırımcılar</th><th scope="col">Tarih</th></tr></thead>
        <tbody>{TR_ROUNDS.map((r) => (
          <tr><td><strong>{r.name}</strong><span class="meta model-note">{r.where}</span></td><td>{r.what}</td><td>{r.round}<span class="meta model-note">{r.amount}</span></td><td>{r.investors}</td><td class="nowrap"><a href={r.src[1]} rel="noopener">{when(r.date)}</a></td></tr>
        ))}</tbody>
      </table>
    </div>
    <p class="price-src">Tüm yapay zeka yatırımları için <a href={url('/yatirimlar/')}>yatırım takipçimize</a> bakın.</p>

    {nextEvents.length > 0 && (
      <>
        <h2 class="ev-h">Yaklaşan etkinlikler</h2>
        <ul class="guide-more-list">{nextEvents.map((e) => <li><a href={url('/etkinlikler/')}>{e.name}</a> <span class="meta">· {e.city}</span></li>)}</ul>
      </>
    )}

    {news.length > 0 && (
      <section class="term-news" aria-labelledby="trn-h">
        <div class="sechead"><h2 id="trn-h">Türkiye ile ilgili son haberler</h2><a class="more" href={url('/kategori/turkiye/')}>Tümü →</a></div>
        {news.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} />)}
      </section>
    )}
    <p class="ai-note">Türkiye ekosisteminden bir gelişmeyi bize iletmek için <a href={url('/hata-bildir/')}>yazın</a>.</p>
  </section>
</Base>
