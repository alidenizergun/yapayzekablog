---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES } from '../../lib/site.js';
import { spreadVisuals, getNews, url } from '../../lib/news.js';
import { i18n, locNewsList } from '../../i18n/index.js';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const L = await i18n(Astro);
const { lang, T, S } = L;
const name = S(`cat.${cat.slug}.name`, cat.name);
const intro = S(`cat.${cat.slug}.intro`, cat.intro);
const items = locNewsList(await getNews(), lang, L.m).filter((n) => n.data.category === cat.slug).slice(0, 60);
const rowV = spreadVisuals(items);
---
<Base title={T(`${cat.name}: son yapay zeka haberleri`, `AI ${name} news`)} description={intro || T(`${cat.name} alanındaki en yeni yapay zeka haberleri.`, `The latest AI news in ${name}.`)} currentCat={cat.slug}
  noindex={items.length === 0}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name, path: `/kategori/${cat.slug}/` }]}
  jsonLd={{ '@type': 'CollectionPage', name: T(`${cat.name}: yapay zeka haberleri`, `AI ${name} news`), inLanguage: L.locale }}>
  <div class="cols flush">
    <section class="main" aria-labelledby="h">
      <div class="sechead"><h1 id="h" class="page-h">{name}</h1><span class="meta">{items.length} {T('haber', items.length === 1 ? 'story' : 'stories')}</span></div>
      {intro && <p class="cat-intro">{intro}{cat.links?.length > 0 && <> {cat.links.map((l, i) => <>{i > 0 && ' · '}<a href={url(l.href)}>{S(`cat.${cat.slug}.link.${i}`, l.label)}</a></>)}</>}</p>}
      {items.length ? items.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} level={2} />) : <p class="empty">{T('Bu kategoride henüz haber yok. Yeni haberler otomatik güncellemelerle eklenecek.', 'No stories in this section yet.')}</p>}
    </section>
    <Sidebar exclude={items.map((n) => n.id)} />
  </div>
</Base>
