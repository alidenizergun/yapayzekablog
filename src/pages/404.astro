---
import Base from '../layouts/Base.astro';
import { url } from '../lib/news.js';
import { i18n } from '../i18n/index.js';
const { T } = await i18n(Astro);
---
<Base title={T('Sayfa bulunamadı', 'Page not found')} noindex description={T('Aradığınız sayfa bulunamadı. YZ Gündemi ana sayfasından en yeni yapay zeka haberlerine ulaşabilirsiniz.', 'Page not found.')}>
  <div class="article" style="padding-block:48px">
    <h1>{T('Bu sayfa bulunamadı', 'Page not found')}</h1>
    <p class="spot">{T('Aradığınız haber kaldırılmış ya da adresi değişmiş olabilir.', 'The story you’re looking for may have been removed or moved.')}</p>
    <p style="margin-top:24px"><a class="btn" href={url('/')}>{T('Ana sayfaya dön', 'Back to home')}</a></p>
  </div>
</Base>
