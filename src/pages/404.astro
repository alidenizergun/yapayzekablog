---
import Base from '../layouts/Base.astro';
import { url, getNews, newsUrl } from '../lib/news.js';
import { i18n } from '../i18n/index.js';
const { T } = await i18n(Astro);
const latest = (await getNews()).slice(0, 5);
---
<Base title={T('Sayfa bulunamadı', 'Page not found')} noindex description={T('Aradığınız sayfa bulunamadı. YZ Gündemi ana sayfasından en yeni yapay zeka haberlerine ulaşabilirsiniz.', 'Page not found.')}>
  <div class="article notfound">
    <span class="cat">404</span>
    <h1>{T('Bu sayfa bulunamadı', 'Page not found')}</h1>
    <p class="spot">{T('Aradığınız haber kaldırılmış ya da adresi değişmiş olabilir. Aramayı deneyin ya da son haberlere göz atın.', 'The page may have been removed or moved. Try a search or browse the latest news.')}</p>
    <form class="search-box" role="search" action={url('/ara/')}>
      <label for="nf-q" class="sr-only">{T('Haberlerde ara', 'Search')}</label>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="nf-q" name="q" type="search" placeholder={T('Örn. OpenAI, Nvidia, halka arz', 'e.g. OpenAI, Nvidia')} enterkeyhint="search" />
    </form>
    <h2 class="ev-h">{T('Son haberler', 'Latest news')}</h2>
    <ul class="guide-more-list">{latest.map((n) => <li><a href={newsUrl(n)}>{n.data.title}</a></li>)}</ul>
    <p class="tools-quick"><a class="btn" href={url('/')}>{T('Ana sayfaya dön', 'Back to home')}</a> <a class="btn btn-ghost" href={url('/arac/')}>{T('Yapay zeka araçları', 'AI tools')}</a> <a class="btn btn-ghost" href={url('/sozluk/')}>{T('Sözlük', 'Glossary')}</a></p>
  </div>
</Base>
<style>
  .notfound { padding-block: 32px 48px; display: flex; flex-direction: column; gap: 16px; }
  .notfound .search-box { max-width: 560px; margin-top: 8px; }
  .notfound .guide-more-list { display: flex; flex-direction: column; gap: 10px; padding-left: 20px; margin: 0; }
  .notfound .guide-more-list a { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>
