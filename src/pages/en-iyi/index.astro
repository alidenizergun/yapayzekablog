---
import Base from '../../layouts/Base.astro';
import { TASKS, toolBySlug } from '../../lib/tools.js';
import { url } from '../../lib/news.js';
import { i18n, locTask } from '../../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;
---
<Base title={T('İşe göre en iyi yapay zeka araçları', 'Best AI tools by task')} description={T('CV, görsel, video, müzik, seslendirme, logo, sunum, kod, çeviri, özet ve toplantı notu için en çok kullanılan yapay zeka araçları.', 'The most widely used AI tools for resumes, images, video, music, voice, logos, presentations, code, translation, summaries and meeting notes.')}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Yapay zeka araçları', 'AI tools'), path: '/arac/' }, { name: T('İşe göre en iyiler', 'Best by task'), path: '/en-iyi/' }]}>
  <section class="glossary">
    <span class="cat">{T('En iyi araçlar', 'Best tools')}</span>
    <h1 class="page-h">{T('İşe göre en iyi yapay zeka araçları', 'Best AI tools by task')}</h1>
    <p class="spot">{T('Ne yapmak istediğinizi seçin; o iş için öne çıkan araçları fiyat, ücretsiz plan ve Türkçe desteğiyle birlikte görün.', 'Pick what you want to do and see the leading tools for the job, with pricing, free plans and Turkish support.')}</p>
    <ul class="guide-list">
      {TASKS.map((k) => (
        <li class="guide-item"><h2><a href={url(`/en-iyi/${k.slug}/`)}>{locTask(k, lang).title}</a></h2><p>{k.picks.map(([s]) => toolBySlug(s).name).join(', ')}</p></li>
      ))}
    </ul>
  </section>
</Base>
