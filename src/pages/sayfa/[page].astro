---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { spreadVisuals, getNews, url, HOME_MAIN } from '../../lib/news.js';
import { i18n, locNewsList } from '../../i18n/index.js';

const PER_PAGE = 12;
const OFFSET = HOME_MAIN; // ana sayfanın ana akışında gösterilenlerden sonrası

export async function getStaticPaths() {
  const news = await getNews();
  const rest = Math.max(0, news.length - HOME_MAIN);
  const pages = Math.ceil(rest / 12);
  return Array.from({ length: pages }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const page = Number(Astro.params.page);
const L = await i18n(Astro);
const { lang, T } = L;
const news = locNewsList(await getNews(), lang, L.m);
const start = OFFSET + (page - 2) * PER_PAGE;
const items = news.slice(start, start + PER_PAGE);
const hasNext = news.length > start + PER_PAGE;
const prev = page === 2 ? url('/') : url(`/sayfa/${page - 1}/`);
const rowV = spreadVisuals(items);
---
<Base title={T(`Haberler, sayfa ${page}`, `News, page ${page}`)} description={T(`YZ Gündemi yapay zeka haber arşivi, sayfa ${page}: modeller, yatırımlar, regülasyon ve araştırmalar.`, `YZ Gündemi AI news archive, page ${page}: models, funding, regulation and research.`)}>
  <div class="cols flush">
    <section class="main" aria-labelledby="h">
      <div class="sechead"><h1 id="h" class="page-h">{T('Tüm haberler', 'All news')}</h1><span class="meta">{T('Sayfa', 'Page')} {page}</span></div>
      {items.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} level={2} />)}
      <div class="pager">
        <a href={prev}>{T('← Daha yeni', '← Newer')}</a>
        {hasNext ? <a href={url(`/sayfa/${page + 1}/`)}>{T('Daha eski →', 'Older →')}</a> : <span></span>}
      </div>
    </section>
    <Sidebar exclude={items.map((n) => n.id)} />
  </div>
</Base>
