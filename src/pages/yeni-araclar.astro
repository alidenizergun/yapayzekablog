---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import NewsRow from '../components/NewsRow.astro';
import { TOOLS, trDate } from '../lib/tools.js';
import { getNews, newsUrl, spreadVisuals, formatDate, url } from '../lib/news.js';

const news = await getNews();
const launches = news.filter((n) => n.data.newTool);
const toolNews = news.filter((n) => !n.data.newTool && ['araclar', 'ajanlar'].includes(n.data.category)).slice(0, 8);
const rowV = spreadVisuals(toolNews);
const recent = [...TOOLS].sort((a, b) => b.added.localeCompare(a.added)).slice(0, 6);
---
<Base title="Yeni yapay zeka araçları: bu hafta çıkan uygulamalar ve özellikler" description="Yeni çıkan yapay zeka araçları ve uygulamaları, büyük asistanlara gelen yeni özellikler ve araç rehberimize son eklenenler; her gün güncellenir."
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: 'Yapay zeka araçları', path: '/arac/' }, { name: 'Yeni araçlar', path: '/yeni-araclar/' }]}>
  <section class="glossary">
    <span class="cat">Radar</span>
    <h1 class="page-h">Yeni yapay zeka araçları</h1>
    <p class="spot">Haberlerimizde duyurusu yapılan yeni yapay zeka araçları, mevcut asistanlara gelen yeni özellikler ve araç rehberimize son eklenenler. Liste haber motorumuzla her gün güncellenir.</p>

    <h2 class="ev-h">Yeni çıkan araçlar</h2>
    {launches.length ? (
      <ol class="ev-list">
        {launches.map((n) => (
          <li class="ev">
            <div class="ev-date"><time datetime={n.data.date.toISOString()}>{formatDate(n.data.date, false)}</time></div>
            <div class="ev-body">
              <h3><a href={n.data.newTool.url} rel="noopener">{n.data.newTool.name} ↗</a></h3>
              {n.data.newTool.what && <p>{n.data.newTool.what}</p>}
              <p class="meta">Haber: <a href={newsUrl(n)}>{n.data.title}</a></p>
            </div>
          </li>
        ))}
      </ol>
    ) : <p class="empty">Haber motorumuz yeni çıkan araçları burada listeleyecek. Şimdilik yeni özellik haberlerine ve rehbere son eklenen araçlara göz atın.</p>}

    {toolNews.length > 0 && (
      <section class="term-news" aria-labelledby="yn-h">
        <div class="sechead"><h2 id="yn-h">Araç ve özellik haberleri</h2></div>
        {toolNews.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} />)}
      </section>
    )}

    <h2 class="ev-h">Araç rehberine son eklenenler</h2>
    <div class="tool-grid">{recent.map((t) => <ToolCard tool={t} />)}</div>
    <p class="ai-note">Rehberde görmek istediğiniz bir araç mı var? <a href={url('/hata-bildir/')}>Bize yazın</a>.</p>
  </section>
</Base>
