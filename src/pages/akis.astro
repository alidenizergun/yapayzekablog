---
// Akış: tüm haberler ve kısa notlar, en yeniden eskiye, saatleriyle (The Verge "Quick Posts" / Techmeme "River" benzeri).
// Kategori ve tür süzgeci, son ziyaretten beri yeni haber işareti, açılır "Kısaca", kalıcı bağlantılar ve sonraki güncelleme saati.
import Base from '../layouts/Base.astro';
import { getNews, newsUrl, catName, slugOf, url } from '../lib/news.js';
import { storyOf } from '../lib/stories.js';
import { render } from 'astro:content';
import { i18n, locNewsList } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T, S } = L;
const EN = lang === 'en';

const all = locNewsList(await getNews(), lang, L.m).slice(0, 120);
const IST = 3 * 3600e3;
const dayKey = (d) => new Date(d.valueOf() + IST).toISOString().slice(0, 10);
const MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const DAYS = ['Pazar', 'Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi'];
const dayLabel = (k) => { const d = new Date(`${k}T12:00:00Z`); return EN ? new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(d) : `${Number(k.slice(8))} ${MONTHS[d.getUTCMonth()]} ${DAYS[d.getUTCDay()]}`; };
const days = [];
for (const n of all) {
  const k = dayKey(n.data.date);
  let g = days.find((x) => x.k === k);
  if (!g) days.push((g = { k, items: [] }));
  g.items.push({ n, story: storyOf(n), Content: n.data.format === 'kisa' ? (await render(n.en ?? n)).Content : null });
}
const cats = [...new Set(all.map((n) => n.data.category))].map((c) => ({ c, name: S(`cat.${c}.name`, catName(c)), count: all.filter((n) => n.data.category === c).length })).sort((a, b) => b.count - a.count);
const shortCount = all.filter((n) => n.data.format === 'kisa').length;
const latest = all[0]?.data.date;
---
<Base title={T('Son haberler: yapay zeka gündemi', 'Latest AI news')} description={T("YZ Gündemi'nde yayımlanan tüm yapay zeka haberleri ve kısa notlar, en yeniden eskiye, saatleriyle; kategoriye göre süzülebilir.", 'Every AI story and brief we publish, newest first, with times; filter by section.')}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Son haberler', 'Latest'), path: '/akis/' }]}>
  <section class="glossary river" data-river>
    <span class="cat">{T('Haberler', 'News')}</span>
    <h1 class="page-h">{T('Son haberler', 'Latest news')}</h1>
    <p class="spot">{T('Yayımladığımız tüm haberler ve kısa notlar, en yeniden eskiye. Site günde dört kez güncellenir: gece turunda günün haberleri, gün içindeki üç ara turda kayda değer yeni gelişmeler eklenir.', 'Every story and brief we publish, newest first. Updated four times a day.')}</p>

    <div class="river-status" aria-live="polite">
      {latest && <span>{T('Son güncelleme', 'Last updated')}: <time datetime={latest.toISOString()}>{dayLabel(dayKey(latest))}</time></span>}
      <span class="river-new" data-new-count hidden></span>
    </div>

    <div class="deal-filters river-filters" role="group" aria-label={T('Süz', 'Filter')} data-river-filters>
      <button type="button" aria-pressed="true" data-f="">{T('Tümü', 'All')} <span class="meta">{all.length}</span></button>
      {shortCount > 0 && <button type="button" aria-pressed="false" data-f="kisa">{T('Kısa notlar', 'Briefs')} <span class="meta">{shortCount}</span></button>}
      {cats.map((c) => <button type="button" aria-pressed="false" data-f={`c:${c.c}`}>{c.name} <span class="meta">{c.count}</span></button>)}
    </div>

    {days.map((g) => (
      <section class="river-day" data-day aria-labelledby={`d-${g.k}`}>
        <h2 id={`d-${g.k}`} class="river-dayh"><span data-day-label={g.k}>{dayLabel(g.k)}</span> <span class="meta">· <span data-day-count>{g.items.length}</span> haber</span></h2>
        <ol class="river-list">
          {g.items.map(({ n, story, Content }) => {
            const d = n.data;
            const id = slugOf(n);
            return (
              <li class={`river-item${Content ? ' is-short' : ''}`} id={id} data-item data-cat={d.category} data-kind={Content ? 'kisa' : 'haber'} data-ts={d.date.valueOf()}>
                <div class="river-main">
                  <p class="river-tags">
                    <span class="cat">{S(`cat.${d.category}.name`, catName(d.category))}</span>
                    {Content && <span class="river-kind">{T('Kısa not', 'Brief')}</span>}
                    {story && <a class="river-chip" href={url(`/gelisme/${story.slug}/`)}>{T('Gelişen hikâye', 'Developing story')}</a>}
                    {d.deal && <a class="river-chip" href={url('/yatirimlar/')}>{T(d.deal.type, ({ 'Yatırım turu': 'Funding round', 'Satın alma': 'Acquisition', 'Halka arz': 'IPO', 'Anlaşma': 'Deal', 'Tesis yatırımı': 'Facility investment' })[d.deal.type] ?? d.deal.type)}</a>}
                    {d.newTool && <a class="river-chip" href={url('/yeni-araclar/')}>{T('Yeni araç', 'New tool')}</a>}
                    <span class="river-newdot" hidden data-newdot>{T('Yeni', 'New')}</span>
                  </p>
                  <h3><a href={newsUrl(n)}>{d.title}</a></h3>
                  {Content ? <div class="river-body"><Content /></div> : <p>{d.spot}</p>}
                  {!Content && d.keyPoints && d.keyPoints.length >= 2 && (
                    <details class="river-kp"><summary>{T('Kısaca', 'Key points')}</summary><ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul></details>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
    <p class="river-more"><button type="button" class="btn btn-ghost" data-more hidden>{T('Daha fazla göster', 'Show more')}</button></p>
    <p class="empty" data-empty hidden>{T('Bu süzgece uyan haber yok.', 'No stories match this filter.')}</p>
    <p class="ai-note">{T('Daha eski haberler için', 'For older stories, see the')} <a href={url('/sayfa/2/')}>{T('arşive', 'archive')}</a> {T('veya', 'or the')} <a href={url('/haftalik/')}>{T('haftalık özetlere', 'weekly digests')}</a>{T(' bakın.', '.')}</p>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-river]');
  if (root) {
    const PAGE = 30;
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const daysEls = [...root.querySelectorAll<HTMLElement>('[data-day]')];
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-river-filters] button')];
    const moreBtn = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let filter = '', limit = PAGE;

    // Gün başlıkları: bugün / dün (ziyaret anına göre)
    const ist = (t: number) => new Date(t + 3 * 3600e3).toISOString().slice(0, 10);
    const today = ist(Date.now()), yest = ist(Date.now() - 86400e3);
    root.querySelectorAll<HTMLElement>('[data-day-label]').forEach((el) => {
      const k = el.dataset.dayLabel!;
      const EN = document.documentElement.lang === 'en';
      if (k === today) el.textContent = `${EN ? 'Today' : 'Bugün'} · ${el.textContent}`;
      else if (k === yest) el.textContent = `${EN ? 'Yesterday' : 'Dün'} · ${el.textContent}`;
    });

    // Son ziyaretten beri yeni haberler
    let last = 0;
    try { last = Number(localStorage.getItem('yz-akis-son') || 0); localStorage.setItem('yz-akis-son', String(Date.now())); } catch {}
    if (last) {
      const fresh = items.filter((li) => Number(li.dataset.ts) > last);
      fresh.forEach((li) => { li.classList.add('is-new'); li.querySelector<HTMLElement>('[data-newdot]')!.hidden = false; });
      const nc = root.querySelector<HTMLElement>('[data-new-count]')!;
      if (fresh.length) { nc.hidden = false; nc.textContent = document.documentElement.lang === 'en' ? `${fresh.length} new since your last visit` : `Son ziyaretinizden beri ${fresh.length} yeni haber`; }
    }

    const apply = () => {
      let shown = 0, matched = 0;
      items.forEach((li) => {
        const ok = !filter || (filter === 'kisa' ? li.dataset.kind === 'kisa' : `c:${li.dataset.cat}` === filter);
        if (ok) matched++;
        const vis = ok && matched <= limit;
        li.hidden = !vis;
        if (vis) shown++;
      });
      daysEls.forEach((d) => {
        const vis = d.querySelectorAll('[data-item]:not([hidden])').length;
        d.hidden = vis === 0;
        const c = d.querySelector('[data-day-count]'); if (c) c.textContent = String(vis);
      });
      moreBtn.hidden = matched <= limit;
      empty.hidden = matched > 0;
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      filter = b.dataset.f || ''; limit = PAGE; apply();
    }));
    moreBtn.addEventListener('click', () => { limit += PAGE; apply(); });

    // Kalıcı bağlantıyla gelindiyse o haberi göster
    const target = location.hash ? root.querySelector<HTMLElement>(location.hash.replace(/[^#\w-]/g, '')) : null;
    if (target) { limit = items.indexOf(target) + PAGE; }
    apply();
    if (target) { target.classList.add('is-target'); target.scrollIntoView({ block: 'center' }); }
  }
</script>
