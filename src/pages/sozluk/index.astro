---
import Base from '../../layouts/Base.astro';
import { GLOSSARY, GLOSSARY_CATS } from '../../lib/glossary.js';
import { url } from '../../lib/news.js';

const terms = [...GLOSSARY].sort((a, b) => a.term.localeCompare(b.term, 'tr'));
// Alfabe gezinmesi: yalnızca terimi olan harfler
const letterOf = (t) => t.term[0].toLocaleUpperCase('tr');
const letters = [...new Set(terms.map(letterOf))];
const byCat = GLOSSARY_CATS.map((c) => ({ c, items: terms.filter((t) => t.cat === c) }));
const pageUrl = new URL(url('/sozluk/'), Astro.site).href;
const jsonLd = {
  '@type': 'DefinedTermSet', '@id': `${pageUrl}#sozluk`, name: 'Yapay zeka terimleri sözlüğü', inLanguage: 'tr-TR',
  hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, alternateName: t.en, description: t.def, url: new URL(url(`/sozluk/${t.slug}/`), Astro.site).href, inDefinedTermSet: { '@id': `${pageUrl}#sozluk` } })),
};
---
<Base title="Yapay zeka terimleri sözlüğü" description={`Yapay zeka sözlüğü: makine öğrenmesi, derin öğrenme, büyük dil modeli, token, istem, halüsinasyon, deepfake dahil ${terms.length} terimin sade Türkçe açıklaması.`}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: 'Terimler sözlüğü', path: '/sozluk/' }]}>
  <section class="glossary" data-pagefind-body>
    <span class="cat" data-pagefind-ignore>Sözlük</span>
    <h1 class="page-h" data-pagefind-meta="title">Yapay zeka terimleri sözlüğü</h1>
    <p class="spot">Haberlerde geçen teknik terimlerin sade Türkçe açıklamaları. Haber metinlerinde bu terimlerin altı noktalıdır; tıklayınca terimin ayrıntılı açıklamasına gidersiniz.</p>
    <section class="glossary-bycat" aria-labelledby="bycat-h" data-pagefind-ignore>
      <h2 id="bycat-h" class="ev-h">Konulara göre</h2>
      {byCat.map((g) => (
        <div class="glossary-cat">
          <h3>{g.c}</h3>
          <p>{g.items.map((t, i) => <>{i > 0 && ' · '}<a href={url(`/sozluk/${t.slug}/`)}>{t.term}</a></>)}</p>
        </div>
      ))}
    </section>
    <h2 class="ev-h">A'dan Z'ye tüm terimler</h2>
    <nav class="glossary-az" aria-label="Harfe göre" data-pagefind-ignore>
      {letters.map((l) => <a href={`#harf-${l}`}>{l}</a>)}
    </nav>
    <dl class="glossary-list">
      {terms.map((t, i) => (
        <div class="glossary-item" id={t.slug}>
          {(i === 0 || letterOf(terms[i - 1]) !== letterOf(t)) && <span class="glossary-anchor" id={`harf-${letterOf(t)}`} aria-hidden="true"></span>}
          <dt><a href={url(`/sozluk/${t.slug}/`)}>{t.term}</a> <span class="glossary-en" lang="en">{t.en}</span></dt>
          <dd>{t.def} <a class="glossary-more" href={url(`/sozluk/${t.slug}/`)}>Devamı: {t.term.replace(/\s*\(.*\)$/, '')} nedir? →</a></dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
