---
import Base from '../layouts/Base.astro';
import DataCite from '../components/DataCite.astro';
import { getNews, newsUrl, formatDate, url } from '../lib/news.js';
import { DEALS, DEALS_CHECKED } from '../lib/deals.js';
import { i18n, locNewsList, DEAL_TYPE_EN, COUNTRY_EN } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;
const EN = lang === 'en';

const fmtM = (m) => EN ? (m >= 1e6 ? `$${(m / 1e6).toLocaleString('en-US', { maximumFractionDigits: 2 })} trillion` : m >= 1000 ? `$${(m / 1000).toLocaleString('en-US', { maximumFractionDigits: 1 })} billion` : `$${m.toLocaleString('en-US')} million`)
  : (m >= 1e6 ? `${(m / 1e6).toLocaleString('tr-TR', { maximumFractionDigits: 2 })} trilyon $` : m >= 1000 ? `${(m / 1000).toLocaleString('tr-TR', { maximumFractionDigits: 1 })} milyar $` : `${m.toLocaleString('tr-TR')} milyon $`);
const money = (x) => {
  const v = fmtM(x.usdM);
  if (x.upTo) return EN ? `up to ${v}` : `en fazla ${v}`;
  if (x.over) return EN ? `over ${v}` : `${v}'dan fazla`;
  if (x.approx) return EN ? `about ${v}` : `yaklaşık ${v}`;
  return v;
};
const ROUND_EN = { 'Tohum': 'Seed', '%49 hisse': '49% stake', 'Stratejik yatırım': 'Strategic investment' };
const MONTHS = EN ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] : ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];

// Sitedeki haberlerden gelen anlaşmalar + arşiv (src/lib/deals.js)
const fromNews = locNewsList(await getNews(), lang, L.m).filter((n) => n.data.deal).map((n) => {
  const d = n.data.deal;
  return { ts: n.data.date.valueOf(), dateText: formatDate(n.data.date, false, L.locale), iso: n.data.date.toISOString().slice(0, 10), type: d.type, company: d.company, counterparty: d.counterparty,
    amount: d.amount, usdM: d.amountUsdM, round: d.round, investors: d.investors, country: d.country, href: newsUrl(n), ext: false, story: true };
});
const archive = DEALS.map((x) => {
  const [y, mo, da] = x.date.split('-').map(Number);
  const orig = x.orig && (EN ? x.orig.en : x.orig.tr);
  return { ts: Date.UTC(y, mo - 1, da, 9), iso: x.date, dateText: x.dateApprox ? `${MONTHS[mo - 1]} ${y}` : formatDate(new Date(Date.UTC(y, mo - 1, da, 9)), false, L.locale),
    type: EN ? DEAL_TYPE_EN[x.type] ?? x.type : x.type, company: x.company, counterparty: x.counterparty,
    amount: orig ?? (x.usdM ? money(x) : undefined), amountNote: orig && x.usdM ? `≈ ${fmtM(x.usdM)}` : undefined, usdM: x.usdM,
    val: x.valUsdM ? `${x.approxVal ? (EN ? 'about ' : 'yaklaşık ') : ''}${fmtM(x.valUsdM)}` : undefined,
    round: x.round && (EN ? ROUND_EN[x.round] ?? x.round : x.round), investors: x.investors, country: EN ? COUNTRY_EN[x.country] ?? x.country : x.country,
    detail: x.detail && (EN ? x.detail.en : x.detail.tr), href: x.url, src: x.src, ext: true };
});
const deals = [...fromNews, ...archive].sort((a, b) => b.ts - a.ts).map((x) => ({ ...x, year: x.iso.slice(0, 4) }));
const types = [...new Set(deals.map((x) => x.type))];
const years = [...new Set(deals.map((x) => x.year))].sort().reverse();
const countries = [...new Set(deals.map((x) => x.country).filter(Boolean))];
const rounds = deals.filter((x) => x.type === (EN ? 'Funding round' : 'Yatırım turu'));
const raised = rounds.reduce((a, x) => a + (x.usdM || 0), 0);
const checked = formatDate(new Date(`${DEALS_CHECKED}T12:00:00+03:00`), false, L.locale);
const pageUrl = new URL(url('/yatirimlar/'), Astro.site).href;
const abs = (h) => (/^https?:/.test(h) ? h : new URL(h, Astro.site).href);
// Aylık grafik ve öne çıkan rakamlar (yalnızca yatırım turları)
const MSHORT = EN ? ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] : ['Oca', 'Şub', 'Mar', 'Nis', 'May', 'Haz', 'Tem', 'Ağu', 'Eyl', 'Eki', 'Kas', 'Ara'];
const now = new Date();
const months = [];
for (let y = 2025, mo = 0; y * 12 + mo <= now.getUTCFullYear() * 12 + now.getUTCMonth(); mo === 11 ? (y++, (mo = 0)) : mo++) {
  const key = `${y}-${String(mo + 1).padStart(2, '0')}`;
  const inMonth = rounds.filter((x) => x.iso.startsWith(key));
  months.push({ key, label: MSHORT[mo], year: y, first: mo === 0, sum: inMonth.reduce((a, x) => a + (x.usdM || 0), 0), n: inMonth.length });
}
const maxSum = Math.max(...months.map((x) => x.sum), 1);
const CH = { w: 760, h: 240, top: 26, bottom: 38, left: 8, right: 8 };
const bw = (CH.w - CH.left - CH.right) / months.length;
const barH = (v) => ((CH.h - CH.top - CH.bottom) * v) / maxSum;
const shortB = (m) => (m >= 1000 ? `${Math.round(m / 1000)}` : m > 0 ? '<1' : '');
const biggest = [...rounds].filter((x) => x.usdM).sort((a, b) => b.usdM - a.usdM)[0];
const byYear = (y) => rounds.filter((x) => x.year === y).reduce((a, x) => a + (x.usdM || 0), 0);
const billionPlus = rounds.filter((x) => (x.usdM || 0) >= 1000).length;
const companyCount = new Map();
for (const x of deals) companyCount.set(x.company, (companyCount.get(x.company) || 0) + 1);
const [topCo, topCoN] = [...companyCount].sort((a, b) => b[1] - a[1])[0];
const peak = months.reduce((a, b) => (b.sum > a.sum ? b : a));
const chartLabel = T(`Ay ay yatırım turlarında toplanan tutar, Ocak 2025'ten bugüne. En yüksek ay: ${peak.label} ${peak.year}, ${fmtM(peak.sum)}.`, `Amount raised in funding rounds by month since January 2025. Peak month: ${peak.label} ${peak.year}, ${fmtM(peak.sum)}.`);

const jsonLd = [{
  '@type': 'Dataset', name: T('Yapay zeka yatırımları ve satın almaları veri seti', 'AI funding and acquisitions dataset'), url: pageUrl, inLanguage: L.locale, isAccessibleForFree: true,
  description: T(`Ocak 2025'ten bu yana yapay zeka alanındaki ${deals.length} büyük yatırım turu, satın alma, halka arz, birleşme ve altyapı anlaşması: tarih, tür, şirket, karşı taraf, tutar, değerleme, yatırımcılar, ülke ve kaynak bağlantısı. YZ Gündemi tarafından derlenir ve yeni haberlerle güncellenir.`, `${deals.length} major AI funding rounds, acquisitions, IPOs, mergers and infrastructure deals since January 2025, with date, type, company, counterparty, amount, valuation, investors, country and source link. Compiled by YZ Gündemi and updated with new stories.`),
  creator: { '@id': new URL(url('/#organization'), Astro.site).href }, dateModified: DEALS_CHECKED, temporalCoverage: `2025-01-01/${DEALS_CHECKED}`,
  keywords: ['yapay zeka', 'yatırım', 'satın alma', 'girişim', 'AI funding', 'venture capital'],
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: new URL(url('/veri/yatirimlar.csv'), Astro.site).href }],
}, {
  '@type': 'CollectionPage', name: T('Yapay zeka yatırımları ve satın almaları', 'AI funding and acquisitions tracker'), inLanguage: L.locale, url: pageUrl,
  mainEntity: { '@type': 'ItemList', numberOfItems: deals.length, itemListElement: deals.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(x.href), name: `${x.company}${x.counterparty ? ' – ' + x.counterparty : ''}: ${x.type}` })) },
}];
---
<Base title={T('Yapay zeka yatırımları ve satın almaları', 'AI funding and acquisitions tracker')} description={T(`Ocak 2025'ten bu yana yapay zekadaki ${deals.length} büyük yatırım turu, satın alma, halka arz ve altyapı anlaşması: OpenAI, Anthropic, xAI, Nvidia ve diğerleri. Yıla, türe ve şirkete göre süzülebilir.`, `${deals.length} major AI funding rounds, acquisitions, IPOs and infrastructure deals since January 2025, from OpenAI, Anthropic and xAI to Nvidia. Filter by year, type and company.`)}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Yatırım takipçisi', 'Funding tracker'), path: '/yatirimlar/' }]}>
  <section class="deals">
    <span class="cat">{T('Takipçi', 'Tracker')}</span>
    <h1 class="page-h">{T('Yapay zeka yatırımları ve satın almaları', 'AI funding and acquisitions')}</h1>
    <p class="spot">{T("Ocak 2025'ten bu yana yapay zeka şirketlerine yapılan büyük yatırımlar, satın almalar, halka arzlar ve altyapı anlaşmaları. Yeni anlaşmalar YZ Gündemi'nde yayınlanan haberlerden otomatik eklenir; her satır habere ya da resmi kaynağa bağlanır.", 'Major funding rounds, acquisitions, IPOs and infrastructure deals in AI since January 2025. New deals are added automatically from stories on YZ Gündemi; each row links to the story or the original source.')}</p>
    <p class="models-checked">{T('Arşiv son kontrol', 'Archive last checked')}: <time datetime={DEALS_CHECKED}>{checked}</time></p>

    <dl class="deal-stats">
      <div><dt>{T('Kayıtlı anlaşma', 'Deals tracked')}</dt><dd>{deals.length}</dd></div>
      <div><dt>{T('Yatırım turlarında toplanan', 'Raised in funding rounds')}</dt><dd>{fmtM(raised)}</dd></div>
      <div><dt>{T('Ülke', 'Countries')}</dt><dd>{countries.length}</dd></div>
    </dl>

    <section class="deal-insights" aria-labelledby="ins-h">
      <h2 id="ins-h" class="ev-h">{T('Rakamlarla', 'By the numbers')}</h2>
      <ul class="deal-facts">
        {biggest && <li><strong>{fmtM(biggest.usdM)}</strong> {T(`ile en büyük yatırım turu: ${biggest.company} (${biggest.dateText})`, `is the largest funding round: ${biggest.company} (${biggest.dateText})`)}</li>}
        <li><strong>{fmtM(byYear('2025'))}</strong> {T("2025'te yatırım turlarında toplandı;", 'raised in funding rounds in 2025;')} <strong>{fmtM(byYear('2026'))}</strong> {T("2026'da bugüne kadar.", 'in 2026 so far.')}</li>
        <li><strong>{billionPlus}</strong> {T('yatırım turu 1 milyar doları aştı.', 'funding rounds topped $1 billion.')}</li>
        <li><strong>{topCo}</strong> {T(`listede en çok yer alan şirket (${topCoN} kayıt).`, `appears most often in the list (${topCoN} entries).`)}</li>
      </ul>
      <figure class="deal-chart" tabindex="0" aria-label={T("Aylık yatırım grafiği", "Monthly funding chart")}>
        <svg viewBox={`0 0 ${CH.w} ${CH.h}`} role="img" aria-label={chartLabel} preserveAspectRatio="xMidYMid meet">
          {months.map((mo, i) => {
            const h = barH(mo.sum); const x = CH.left + i * bw; const y0 = CH.h - CH.bottom;
            return (
              <g>
                <title>{`${mo.label} ${mo.year}: ${mo.sum ? fmtM(mo.sum) : '—'} · ${mo.n} ${T('tur', 'rounds')}`}</title>
                <rect x={x + bw * 0.15} y={y0 - h} width={bw * 0.7} height={Math.max(h, mo.sum ? 1.5 : 0)} rx="2" class="bar" />
                {mo.sum > 0 && <text x={x + bw / 2} y={y0 - h - 6} text-anchor="middle" class="val">{shortB(mo.sum)}</text>}
                <text x={x + bw / 2} y={y0 + 15} text-anchor="middle" class="lbl">{mo.label}</text>
                {mo.first && <text x={x + bw * 0.15} y={y0 + 31} class="yr">{mo.year}</text>}
              </g>
            );
          })}
          <line x1={CH.left} x2={CH.w - CH.right} y1={CH.h - CH.bottom} y2={CH.h - CH.bottom} class="axis" />
        </svg>
        <figcaption class="meta">{T('Ay ay yatırım turlarında toplanan tutar (milyar $). Satın almalar, halka arzlar ve altyapı anlaşmaları dahil değildir. Çubukların üzerine gelerek ayrıntıyı görebilirsiniz.', 'Amount raised in funding rounds by month ($ billion). Excludes acquisitions, IPOs and infrastructure deals. Hover a bar for details.')}</figcaption>
      </figure>
    </section>

    <div class="deal-filters" role="group" aria-label={T('Yıla göre süz', 'Filter by year')} data-deal-years>
      <button type="button" aria-pressed="true" data-year="">{T('Tüm yıllar', 'All years')}</button>
      {years.map((y) => <button type="button" aria-pressed="false" data-year={y}>{y}</button>)}
    </div>
    <div class="deal-filters deal-filters-2" role="group" aria-label={T('Türe göre süz', 'Filter by type')} data-deal-filters>
      <button type="button" aria-pressed="true" data-type="">{T('Tümü', 'All')}</button>
      {types.map((t) => <button type="button" aria-pressed="false" data-type={t}>{t}</button>)}
    </div>
    <label class="sr-only" for="deal-q">{T('Şirket ara', 'Search companies')}</label>
    <input id="deal-q" class="deal-search" type="search" placeholder={T('Şirket veya ülke ara', 'Search company or country')} data-deal-q />

    <div class="deal-table-wrap">
      <table class="deal-table">
        <thead><tr><th scope="col">{T('Tarih', 'Date')}</th><th scope="col">{T('Şirket', 'Company')}</th><th scope="col">{T('Tür', 'Type')}</th><th scope="col">{T('Tutar', 'Amount')}</th><th scope="col">{T('Karşı taraf / ayrıntı', 'Counterparty / details')}</th><th scope="col">{T('Ülke', 'Country')}</th></tr></thead>
        <tbody>
          {deals.map((x) => (
            <tr data-type={x.type} data-year={x.year} data-text={`${x.company} ${x.counterparty ?? ''} ${x.country ?? ''} ${(x.investors ?? []).join(' ')}`.toLocaleLowerCase(lang)}>
              <td class="nowrap"><time datetime={x.iso}>{x.dateText}</time></td>
              <td>{x.ext ? <a href={x.href} rel="noopener"><strong>{x.company}</strong></a> : <a href={x.href}><strong>{x.company}</strong></a>}</td>
              <td><span class="deal-type">{x.type}</span>{x.round && <span class="meta"> · {x.round}</span>}</td>
              <td class="nowrap">{x.amount ?? '—'}{x.amountNote && <span class="meta"><br />{x.amountNote}</span>}</td>
              <td>
                {x.counterparty && <span>{x.counterparty}</span>}
                {x.val && <span class="meta">{x.counterparty ? ' · ' : ''}{T('Değerleme', 'Valuation')}: {x.val}</span>}
                {x.investors?.length ? <span class="meta">{x.counterparty || x.val ? ' · ' : ''}{T('Yatırımcılar', 'Investors')}: {x.investors.join(', ')}</span> : null}
                {x.detail && <span class="deal-detail">{x.detail}</span>}
                {x.ext ? <span class="deal-src meta">{T('Kaynak', 'Source')}: <a href={x.href} rel="noopener">{x.src} ↗</a></span> : <span class="deal-src meta"><a href={x.href}>{T('Haberimiz', 'Our story')} →</a></span>}
              </td>
              <td>{x.country ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty" data-deal-empty hidden>{T('Bu süzgece uyan anlaşma yok.', 'No deals match this filter.')}</p>
    <DataCite name="Yapay zeka yatırım takipçisi" nameEn="AI funding tracker" path="/yatirimlar/" csv="/veri/yatirimlar.csv" checked={DEALS_CHECKED} />
    <p class="ai-note">{T('Tutarlar kaynaklardaki yazımla verilir; avro tutarların dolar karşılığı yaklaşıktır. Altyapı anlaşmalarındaki tutarlar çoğunlukla yıllara yayılan taahhütlerdir. "Yatırım turlarında toplanan" yalnızca yatırım turlarını toplar. Eksik gördüğünüz büyük bir anlaşma varsa', 'Amounts are as reported by the sources; dollar equivalents of euro amounts are approximate. Infrastructure deal values are mostly commitments spread over several years. “Raised in funding rounds” counts funding rounds only. Know of a major deal we’re missing?')} <a href={url('/hata-bildir/')}>{T('bize bildirin', 'Let us know')}</a>.</p>
  </section>
</Base>

<script>
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.deal-table tbody tr')];
  const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-deal-filters] button')];
  const ybtns = [...document.querySelectorAll<HTMLButtonElement>('[data-deal-years] button')];
  let year = '';
  const q = document.querySelector<HTMLInputElement>('[data-deal-q]')!;
  const empty = document.querySelector<HTMLElement>('[data-deal-empty]')!;
  let type = '';
  const apply = () => {
    const term = q.value.trim().toLocaleLowerCase(document.documentElement.lang || 'tr');
    let shown = 0;
    rows.forEach((r) => { const ok = (!type || r.dataset.type === type) && (!year || r.dataset.year === year) && (!term || r.dataset.text!.includes(term)); r.hidden = !ok; if (ok) shown++; });
    empty.hidden = shown > 0;
  };
  btns.forEach((b) => b.addEventListener('click', () => { type = b.dataset.type!; btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); }));
  ybtns.forEach((b) => b.addEventListener('click', () => { year = b.dataset.year!; ybtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(); }));
  q.addEventListener('input', apply);
</script>
