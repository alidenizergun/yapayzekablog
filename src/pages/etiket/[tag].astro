---
import Base from '../../layouts/Base.astro';
import NewsRow from '../../components/NewsRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getTags, spreadVisuals } from '../../lib/news.js';

export async function getStaticPaths() {
  const tags = await getTags();
  return [...tags.values()].map((t) => ({ params: { tag: t.slug }, props: { tag: t } }));
}
const { tag } = Astro.props;
const items = tag.items.slice(0, 60);
const rowV = spreadVisuals(items);
// "YönetimKurulu" -> "Yönetim Kurulu" (kısaltmalar korunur: OpenAI, AIArama -> AI Arama)
const human = tag.name.replace(/(\p{Ll})(\p{Lu})/gu, '$1 $2').replace(/(\p{Lu})(\p{Lu}\p{Ll})/gu, '$1 $2');
const keep = /^(OpenAI|ChatGPT|DeepSeek|HuggingFace|GitHub|DeepMind|xAI)$/;
const label = keep.test(tag.name) ? tag.name : human;
const desc = `${label} ile ilgili ${items.length} yapay zeka haberi. Son gelişme: ${items[0]?.data.title ?? ''}`;
---
<Base
  title={`${label} haberleri`}
  description={desc}
  breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: `${label} haberleri`, path: `/etiket/${tag.slug}/` }]}
  jsonLd={{ '@type': 'CollectionPage', name: `${label} haberleri`, inLanguage: 'tr-TR' }}
  noindex={items.length < 2}
>
  <div class="cols" style="margin-top:0">
    <section class="main" aria-labelledby="h">
      <div class="sechead"><h1 id="h" class="page-h">#{tag.name}</h1><span class="meta">{items.length} haber</span></div>
      {items.map((n) => <NewsRow item={n} choice={rowV.get(n.id)} />)}
    </section>
    <Sidebar exclude={items.map((n) => n.id)} />
  </div>
</Base>
