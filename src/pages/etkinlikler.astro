---
import Base from '../layouts/Base.astro';
import { EVENTS, EVENTS_CHECKED } from '../lib/events.js';
import { formatDate, url } from '../lib/news.js';
import { i18n } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T, S } = L;
const EN = lang === 'en';
const EV = EVENTS.map((e, i) => ({ ...e, ...Object.fromEntries(['name', 'type', 'venue', 'city', 'organizer', 'approx', 'note'].filter((f) => e[f]).map((f) => [f, S(`event.${i}.${f}`, e[f])])) }));

const today = new Date(Date.now() + 3 * 3600e3).toISOString().slice(0, 10);
const upcoming = EV.filter((e) => e.end >= today).sort((a, b) => a.start.localeCompare(b.start));
const past = EV.filter((e) => e.end < today).sort((a, b) => b.start.localeCompare(a.start));
const MONTHS = EN ? ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] : ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const p = (s) => s.split('-').map(Number);
const when = (e) => {
  if (e.approx) return e.approx;
  const [y1, m1, d1] = p(e.start), [y2, m2, d2] = p(e.end);
  if (EN) {
    if (e.start === e.end) return `${MONTHS[m1 - 1]} ${d1}, ${y1}`;
    if (y1 === y2 && m1 === m2) return `${MONTHS[m1 - 1]} ${d1}–${d2}, ${y1}`;
    return `${MONTHS[m1 - 1]} ${d1} – ${MONTHS[m2 - 1]} ${d2}, ${y2}`;
  }
  if (e.start === e.end) return `${d1} ${MONTHS[m1 - 1]} ${y1}`;
  if (y1 === y2 && m1 === m2) return `${d1}-${d2} ${MONTHS[m1 - 1]} ${y1}`;
  return `${d1} ${MONTHS[m1 - 1]} - ${d2} ${MONTHS[m2 - 1]} ${y2}`;
};
const pageUrl = new URL(url('/etkinlikler/'), Astro.site).href;
const checked = formatDate(new Date(`${EVENTS_CHECKED}T12:00:00+03:00`), false, L.locale);
const jsonLd = upcoming.filter((e) => !e.approx).map((e) => ({
  '@type': 'Event', name: e.name, startDate: e.start, endDate: e.end, eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', inLanguage: 'tr-TR', ...(e.url ? { url: e.url } : {}),
  location: { '@type': 'Place', name: e.venue || e.city, address: { '@type': 'PostalAddress', addressLocality: e.city.replace(/\s*\(.*\)/, ''), addressCountry: 'TR' } },
  ...(e.organizer ? { organizer: { '@type': 'Organization', name: e.organizer } } : {}),
}));
---
<Base title={T('Türkiye yapay zeka etkinlikleri takvimi: zirveler, konferanslar, fuarlar', 'AI events in Turkey: summits, conferences and expos')} description={T("Türkiye'de düzenlenecek yapay zeka zirveleri, konferansları ve fuarları: tarih, şehir, mekan ve düzenleyen bilgisiyle güncel etkinlik takvimi.", 'Upcoming AI summits, conferences and expos in Turkey, with dates, cities, venues and organizers.')}
  jsonLd={jsonLd} breadcrumbs={[{ name: 'Ana sayfa', path: '/' }, { name: T('Etkinlik takvimi', 'Events'), path: '/etkinlikler/' }]}>
  <section class="deals events">
    <span class="cat">{T('Takvim', 'Calendar')}</span>
    <h1 class="page-h">{T('Türkiye yapay zeka etkinlikleri takvimi', 'AI events in Turkey')}</h1>
    <p class="spot">{T("Türkiye'de düzenlenecek yapay zeka zirveleri, konferansları ve fuarları. Her etkinlik bir kaynağa bağlanır; katılmadan önce tarih ve kayıt koşullarını etkinliğin resmi sayfasından kontrol edin.", 'AI summits, conferences and expos in Turkey. Each event links to a source; check dates and registration on the official page before you go.')}</p>
    <p class="models-checked">{T('Son kontrol', 'Last checked')}: <time datetime={EVENTS_CHECKED}>{checked}</time></p>

    <h2 class="ev-h">{T('Yaklaşan etkinlikler', 'Upcoming')}</h2>
    {upcoming.length ? (
      <ol class="ev-list">
        {upcoming.map((e) => (
          <li class="ev">
            <div class="ev-date"><time datetime={e.start}>{when(e)}</time></div>
            <div class="ev-body">
              <span class="ev-type">{e.type}</span>
              <h3>{e.url ? <a href={e.url} rel="noopener">{e.name}</a> : e.name}</h3>
              <p>{[e.city, e.venue].filter(Boolean).join(' · ')}</p>
              {e.note && <p class="meta">{e.note}</p>}
              {e.organizer && <p class="meta">{T('Düzenleyen', 'Organizer')}: {e.organizer}</p>}
              <p class="meta">{T('Kaynak', 'Source')}: <a href={e.source.url} rel="noopener">{e.source.label}</a></p>
            </div>
          </li>
        ))}
      </ol>
    ) : <p class="empty">{T('Şu anda takvimde yaklaşan etkinlik yok.', 'No upcoming events right now.')}</p>}

    {past.length > 0 && (
      <>
        <h2 class="ev-h">{T('Geçmiş etkinlikler', 'Past events')}</h2>
        <ol class="ev-list ev-past">
          {past.map((e) => (
            <li class="ev">
              <div class="ev-date"><time datetime={e.start}>{when(e)}</time></div>
              <div class="ev-body">
                <span class="ev-type">{e.type}</span>
                <h3>{e.name}</h3>
                <p>{[e.city, e.venue].filter(Boolean).join(' · ')}</p>
                <p class="meta">{T('Kaynak', 'Source')}: <a href={e.source.url} rel="noopener">{e.source.label}</a></p>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}
    <p class="ai-note">{T('Takvimde olmayan bir etkinlik mi var?', 'Know of an event we’re missing?')} <a href={url('/hata-bildir/')}>{T('Bize bildirin', 'Let us know')}</a>{T('; kaynağıyla birlikte ekleyelim.', ' and we’ll add it with a source.')}</p>
  </section>
</Base>
