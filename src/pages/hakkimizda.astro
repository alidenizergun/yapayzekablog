---
import Base from '../layouts/Base.astro';
import { getNews, hostOf, url } from '../lib/news.js';
import { i18n } from '../i18n/index.js';
const L = await i18n(Astro);
const { lang, T } = L;

// Sayfadaki bütün rakamlar haber dosyalarından hesaplanır (derleme anında güncellenir)
const news = await getNews();
const sources = news.flatMap((n) => n.data.sources);
const fmt = (n) => n.toLocaleString(L.locale);
const avg = news.length ? (sources.length / news.length).toLocaleString(L.locale, { maximumFractionDigits: 1 }) : '0';
const byHost = new Map();
for (const s of sources) {
  const h = hostOf(s.url);
  const name = s.publisher || h;
  const e = byHost.get(h) ?? { host: h, name, n: 0 };
  e.n++;
  byHost.set(h, e);
}
const publishers = [...byHost.values()].filter((p) => !BLOCKED_DOMAINS.includes(p.host.replace(/^www\./, ''))).sort((a, b) => b.n - a.n);
const topPublishers = publishers.filter((p) => p.host !== 'x.com').slice(0, 12);
const xCount = byHost.get('x.com')?.n ?? 0;
import { BLOCKED_DOMAINS } from '../lib/blocked-sources.js';
---
<Base title={T('Hakkımızda', 'About us')} description={T("YZ Gündemi'nin yapay zeka haberlerini nasıl hazırladığı, kaynak kuralları ve yayın ilkeleri.", 'How YZ Gündemi produces its AI news, our sourcing rules and editorial standards.')}>
  <div class="about">
    <header class="about-hero">
      <div class="about-intro">
        <span class="cat">{T('Hakkımızda', 'About')}</span>
        <h1>{T('Yapay zeka gündemini Türkçe, kaynağıyla birlikte takip edin.', 'Follow the AI news cycle, with every source in plain view.')}</h1>
        <p class="spot">{T('YZ Gündemi, yapay zeka alanındaki gelişmeleri her gün tarayıp Türkçe haber olarak yayınlar. Haberler yapay zeka desteğiyle yazılır; her birinin altında, bilginin alındığı orijinal kaynaklar yer alır.', 'YZ Gündemi is a Turkish AI news site that scans developments in artificial intelligence every day and publishes them as news. Stories are written with AI assistance, and each one lists the original sources it draws on. This English edition is translated from our Turkish stories.')}</p>
      </div>
      <dl class="about-facts" aria-label={T('Rakamlarla YZ Gündemi', 'YZ Gündemi by the numbers')}>
        <div><dt>{T('Yayınlanan haber', 'Stories published')}</dt><dd>{fmt(news.length)}</dd></div>
        <div><dt>{T('Kaynak bağlantısı', 'Source links')}</dt><dd>{fmt(sources.length)}</dd></div>
        <div><dt>{T('Haber başına kaynak', 'Sources per story')}</dt><dd>{avg}</dd></div>
        <div><dt>{T('Farklı kaynak sitesi', 'Distinct source sites')}</dt><dd>{fmt(publishers.length)}</dd></div>
        <div class="facts-note"><dt class="sr-only">{T('Not', 'Note')}</dt><dd>{T('Rakamlar sitedeki haberlerden otomatik hesaplanır.', 'Figures are calculated automatically from the stories on the site.')}</dd></div>
      </dl>
    </header>

    <section class="about-sec" aria-labelledby="how-h">
      <div class="sechead"><h2 id="how-h">{T('Bir haber nasıl hazırlanır?', 'How a story is made')}</h2></div>
      <ol class="steps">
        <li>
          <span class="step-n" aria-hidden="true">1</span>
          <h3>{T('Tarama', 'Scanning')}</h3>
          <p>{T("Son saatlerdeki gelişmeler web aramasıyla bulunur; şirketlerin resmi duyuruları ve tanınmış haber kuruluşları öncelikli kaynaktır. Aramaların bir kısmı her zaman Türkiye'deki gelişmelere ayrılır.", 'Web searches surface the latest developments, with official company announcements and established news organizations as the primary sources. Some searches are always reserved for developments in Turkey.')}</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">2</span>
          <h3>{T('Seçme ve yazma', 'Selecting and writing')}</h3>
          <p>{T('Haber değeri taşıyan gelişmeler seçilir, daha önce yayınlananlar ve tekrarlar elenir. Yalnızca bülten, derleme sitesi veya kişisel blog yazısına dayanan gelişmeler elenir; şirketin kendi duyurusu ya da tanınmış bir haber kuruluşu aranır. Haberler kaynak metin kopyalanmadan, kendi cümlelerimizle Türkçe yazılır ve her habere okura bağlam veren bir "Bu ne anlama geliyor?" notu eklenir.', 'Newsworthy developments are selected, and anything already covered or duplicated is dropped. Developments that rest only on newsletters, aggregators or personal blogs are dropped in favour of the company’s own announcement or an established news organization. Stories are written in our own words without copying source text, and each one gets a “Why it matters” note that gives the reader context.')}</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">3</span>
          <h3>{T('Kaynak doğrulama', 'Source checks')}</h3>
          <p>{T('Haberdeki her kaynak adresi, araştırma sırasında gerçekten görülen adreslerle karşılaştırılır. Doğrulanmış kaynağı kalmayan haber yayınlanmaz.', 'Every source link in a story is checked against the pages actually seen during research. A story with no verified source left is not published.')}</p>
        </li>
        <li>
          <span class="step-n" aria-hidden="true">4</span>
          <h3>{T('Yayın', 'Publishing')}</h3>
          <p>{T('Site yeniden derlenir; hatalı bir haber dosyası varsa yeni haberler geri alınır ve site bozulmaz. Habere uygun logo veya fotoğraf seçilir.', 'The site is rebuilt; if a story file is broken, the new stories are rolled back so the site stays up. A fitting logo or photo is chosen for each story.')}</p>
        </li>
      </ol>
    </section>

    <section class="about-sec" id="ilkeler" aria-labelledby="rules-h">
      <div class="sechead"><h2 id="rules-h">{T('Yayın ilkelerimiz', 'Our editorial standards')}</h2></div>
      <ul class="rules">
        <li><h3>{T('Kaynaksız haber yok', 'No story without a source')}</h3><p>{T('Her haberde en az bir orijinal kaynak bağlantısı bulunur. Mümkün olduğunda şirketin kendi duyurusu veya araştırmanın kendisi de eklenir.', 'Every story links to at least one original source. Where possible we also link the company’s own announcement or the research itself.')}</p></li>
        <li><h3>{T('Kopya yok', 'No copying')}</h3><p>{T('Kaynak metinler kopyalanmaz. Doğrudan alıntı gerekiyorsa kısa tutulur ve tırnak içinde verilir.', 'We don’t copy source text. Direct quotes are kept short and in quotation marks.')}</p></li>
        <li><h3>{T('Söylenti haber değildir', 'Rumor isn’t news')}</h3><p>{T('Doğrulanmamış iddialar olgu gibi sunulmaz. Bir kişinin açıklaması "söyledi" diye aktarılır, iddia niteliğindeki bilgiler açıkça belirtilir.', 'Unverified claims are never presented as fact. Statements are attributed (“said”), and claims are clearly labeled as such.')}</p></li>
        <li><h3>{T('Görseller ne olduğunu söyler', 'Images say what they are')}</h3><p>{T("Şirket haberlerinde şirketin logosu kullanılır. Fotoğraflar Unsplash, Pexels ve Pixabay'den alınan temsili görsellerdir ve fotoğrafçının adıyla gösterilir. Gerçek kişilerin fotoğrafı kullanılmaz.", 'Company stories use the company’s logo. Photos are illustrative images from Unsplash, Pexels and Pixabay, credited to the photographer. We don’t use photos of real people.')}</p></li>
        <li><h3>{T('Yapay zeka kullanımı açıktır', 'AI use is disclosed')}</h3><p>{T('Haberler yapay zeka desteğiyle derlenir ve her haberin altında bu belirtilir. Yapay zeka hata yapabilir; bu yüzden kaynaklar her zaman görünür.', 'Stories are compiled with AI assistance, and every story says so. AI can make mistakes, which is why sources are always visible.')}</p></li>
        <li><h3>{T('Hatalar düzeltilir', 'Errors get fixed')}</h3><p>{T('Bildirilen her hata kaynaklarla karşılaştırılır. Doğrulanırsa haber düzeltilir ya da yayından kaldırılır; anlamı değiştiren düzeltmeler', 'Every reported error is checked against the sources. If confirmed, the story is corrected or taken down; corrections that change the meaning are listed on the')} <a href={url('/duzeltmeler/')}>{T('Düzeltmeler', 'Corrections')}</a> {T('sayfasında listelenir.', 'page.')}</p></li>
        <li><h3>{T('Çıkar çatışması yok', 'No conflicts of interest')}</h3><p>{T('Şu an reklam ve sponsorlu içerik yayınlamıyoruz; haberini yaptığımız şirketlerden ücret, ürün veya erken erişim karşılığında içerik üretmiyoruz. İleride sponsorlu içerik yayınlarsak açıkça işaretleriz.', 'We currently run no ads or sponsored content, and we don’t produce coverage in exchange for payment, products or early access from the companies we cover. If we ever publish sponsored content, it will be clearly labeled.')}</p></li>
      </ul>
    </section>

    <section class="about-sec" id="imza" aria-labelledby="byline-h">
      <div class="sechead"><h2 id="byline-h">{T('Haberlerde neden imza yok?', 'Why our stories carry no byline')}</h2></div>
      <div class="prose">
        <p>{T('Haberlerimiz tek bir muhabirin değil, yukarıda anlatılan editoryal sürecin ürünüdür: gelişmeler yapay zeka desteğiyle taranır, seçilir ve yazılır; kaynak ve kalite kontrollerinden geçer. Bu yüzden haberlerde kişi imzası yerine yayının adı yer alır.', 'Our stories are the product of the editorial process described above rather than of a single reporter: developments are found, selected and written with AI assistance and pass source and quality checks. That is why stories carry the publication’s name instead of a personal byline.')}</p>
        <p>{T("Yayınlanan her haberin sorumluluğu YZ Gündemi'ne aittir. Yayın bilgileri", 'YZ Gündemi takes responsibility for every story it publishes. Publication details are in the')} <a href={url('/kunye/')}>{T('Künye', 'Masthead')}</a>{T("'de, hata bildirimi için", '; to report an error, use the')} <a href={url('/hata-bildir/')}>{T('Hata bildir', 'Report an error')}</a> {T('formunu kullanabilirsiniz.', 'form.')}</p>
      </div>
    </section>

    {topPublishers.length > 0 && (
      <section class="about-sec" aria-labelledby="pub-h">
        <div class="sechead"><h2 id="pub-h">{T('En çok kaynak gösterdiğimiz yayınlar', 'Our most-cited publications')}</h2><span class="meta">{T('Kaynak bağlantısı sayısı', 'Number of source links')}</span></div>
        <ul class="pubs">
          {topPublishers.map((p) => (
            <li><span class="pub-name">{p.name}</span><span class="pub-host">{p.host}</span><span class="pub-n">{p.n}</span></li>
          ))}
        </ul>
        {xCount > 0 && <p class="meta pubs-note">{T(`Bunlara ek olarak ${fmt(xCount)} kaynak bağlantısı, şirketlerin ve kişilerin X gönderileridir.`, `In addition, ${fmt(xCount)} source links are posts on X by companies and people.`)}</p>}
      </section>
    )}

    <section class="about-cta" aria-labelledby="fix-h">
      <div>
        <h2 id="fix-h">{T('Bir hata mı gördünüz?', 'Spotted an error?')}</h2>
        <p>{T('Yanlış bir bilgi, eksik bir kaynak ya da yazım hatası gördüyseniz bize bildirin. Haberden gelirseniz form hangi haber olduğunu otomatik doldurur.', 'If you see something wrong, a missing source or a typo, let us know. Coming from a story, the form fills in which one automatically.')}</p>
      </div>
      <div class="cta-actions">
        <a class="btn cta-primary" href={url('/hata-bildir/')}>{T('Hata bildir', 'Report an error')}</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .about { display: flex; flex-direction: column; gap: 64px; padding-block: 8px 16px; }
  .about-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: end; padding-bottom: 40px; border-bottom: 3px solid var(--fg); }
  .about-intro { display: flex; flex-direction: column; gap: 14px; }
  .about-intro h1 { font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: -0.03em; font-weight: 800; }
  .about-intro .spot { max-width: 58ch; }

  .about-facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .about-facts > div { background: var(--bg); padding: 18px 20px; display: flex; flex-direction: column-reverse; gap: 4px; }
  .about-facts dt { font-size: var(--fs-sm); color: var(--muted); }
  .about-facts dd { margin: 0; font-family: var(--display); font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .about-facts > .facts-note { grid-column: 1 / -1; margin: 0; padding: 10px 20px; background: var(--soft); flex-direction: row; }
  .about-facts .facts-note dd { font-family: var(--body); font-size: var(--fs-xs); font-weight: 400; letter-spacing: 0; color: var(--muted); line-height: 1.4; }

  .about-sec .sechead { margin-bottom: 24px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; counter-reset: none; }
  .steps li { display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid var(--line); position: relative; }
  .step-n { font-family: var(--display); font-size: 15px; font-weight: 800; color: #fff; background: var(--accent-fill); width: 32px; height: 32px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; }
  .steps h3, .rules h3 { font-size: var(--fs-lg); line-height: var(--lh-heading); }
  .steps p, .rules p { margin: 0; font-size: var(--fs-base); line-height: var(--lh-body); color: var(--muted); }

  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 32px; }
  .rules li { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; background: var(--soft); border-radius: 8px; }

  .pubs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 32px; }
  .pubs li { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name n" "host n"; column-gap: 12px; padding-block: 12px; border-bottom: 1px solid var(--line); }
  .pub-name { grid-area: name; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pub-host { grid-area: host; font-size: var(--fs-sm); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pub-n { grid-area: n; align-self: center; font-family: var(--display); font-size: var(--fs-2xl); font-weight: 800; font-variant-numeric: tabular-nums; }
  .pubs-note { margin: 14px 0 0; }

  .about-cta { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between; padding: 36px 40px; background: var(--band); color: var(--band-fg); border-radius: 8px; }
  .about-cta > div:first-child { flex: 1 1 420px; min-width: 0; }
  .about-cta h2 { font-size: var(--fs-3xl); line-height: var(--lh-tight); }
  .about-cta p { margin: 10px 0 0; color: var(--band-muted); max-width: 60ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta-primary { background: var(--accent-fill); color: #fff; height: 48px; padding: 0 24px; font-size: var(--fs-base); }
  .cta-secondary { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.45); height: 48px; padding: 0 24px; font-size: var(--fs-base); }
  .cta-primary:hover { filter: brightness(1.08); }
  .cta-secondary:hover { border-color: #fff; }

  @media (max-width: 1100px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pubs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .about { gap: 48px; }
    .about-hero { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-bottom: 32px; }
    .about-facts dd { font-size: 32px; }
    .steps, .rules, .pubs { grid-template-columns: minmax(0, 1fr); }
    .about-cta { padding: 28px 22px; }
    .about-cta h2 { font-size: var(--fs-2xl); }
    .cta-actions, .cta-actions .btn { width: 100%; }
  }
</style>
