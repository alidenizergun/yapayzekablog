---
import { CATEGORIES } from '../lib/site.js';
import { getNews, newsUrl, catUrl, catName, popularityOf, getDigests, digestUrl, weekRange } from '../lib/news.js';
import Newsletter from './Newsletter.astro';
import Time from './Time.astro';
import { i18n, locNewsList, locDigest } from '../i18n/index.js';
const L = await i18n(Astro);
const { T, S, lang } = L;

// exclude: sayfada zaten gösterilen haberlerin kimlikleri (tekrar listelenmesin)
// latest: kenar çubuğunun altına son haber başlıklarını ekler (uzun haber sayfaları için)
const { exclude = [], latest = 0, id = 'h' } = Astro.props;
const skip = new Set([].concat(exclude));
const news = locNewsList(await getNews(), lang, L.m);
const weekAgo = Date.now() - 7 * 86400e3;
const thisWeek = news.filter((n) => n.data.date.valueOf() > weekAgo && !skip.has(n.id));
const picks = [...thisWeek].sort((a, b) => popularityOf(b) - popularityOf(a)).slice(0, 5);
const pickIds = new Set(picks.map((n) => n.id));
const recent = latest ? news.filter((n) => !skip.has(n.id) && !pickIds.has(n.id)).slice(0, latest) : [];
const digest = (await getDigests()).map((d) => locDigest(d, lang, L.m)).filter(Boolean)[0];
const counts = CATEGORIES.map((c) => ({ ...c, n: news.filter((x) => x.data.category === c.slug).length })).filter((c) => c.n > 0);
---
<aside class="side-col">
  {picks.length > 0 && (
    <section class="pop" aria-labelledby={`pop-h-${id}`}>
      <div class="sechead sm"><h2 id={`pop-h-${id}`}>{T('Bu hafta', 'This week')}</h2></div>
      {picks.map((n) => (
        <a href={newsUrl(n)}>
          <span class="cat">{S(`cat.${n.data.category}.name`, catName(n.data.category))}</span>
          <span class="t">{n.data.title}</span>
        </a>
      ))}
    </section>
  )}
  {digest && (
    <a class="digest-card" href={digestUrl(digest)}>
      <span class="cat">{T('Haftalık özet', 'Weekly roundup')} · {weekRange(digest.data.weekStart, digest.data.weekEnd, lang)}</span>
      <h3>{digest.data.title}</h3>
      <span class="meta">{digest.data.items.length} {T('gelişme tek sayfada →', 'stories on one page →')}</span>
    </a>
  )}
  <Newsletter id={`email-${id}`} />
  <section class="week" aria-labelledby={`cats-h-${id}`}>
    <span class="cat">{T('Kategoriler', 'Sections')}</span>
    <h2 id={`cats-h-${id}`}>{T('Konuya göre oku', 'Browse by topic')}</h2>
    <div class="cat-tags">
      {counts.map((c) => <a class="tag" href={catUrl(c.slug)}>{S(`cat.${c.slug}.name`, c.name)} <span class="meta">{c.n}</span></a>)}
    </div>
  </section>
  {recent.length > 0 && (
    <section class="breaking" aria-labelledby={`recent-h-${id}`}>
      <div class="sechead sm"><h2 id={`recent-h-${id}`}>{T('Son haberler', 'Latest news')}</h2></div>
      {recent.map((n) => (
        <a href={newsUrl(n)}><span class="when"><Time date={n.data.date} /></span><span class="t">{n.data.title}</span></a>
      ))}
    </section>
  )}
</aside>
