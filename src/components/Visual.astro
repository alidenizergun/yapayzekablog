---
// Haber görseli: şirket logo kartı ya da Unsplash/Pexels fotoğrafı (haberin kendi fotoğrafı veya kategori havuzundan).
// İllüstrasyon kullanılmaz; hiç görsel yoksa görselsiz, yalnızca bölüm adını gösteren yer tutucu.
// choice verilmezse haberin kendi görseli kullanılır (bkz. defaultVisual).
import { brandOf } from '../lib/brands.js';
import { brandLogo } from '../lib/brand-logos.js';
import { url } from '../lib/news.js';
import { defaultVisual, photoSet, photoSource, catName } from '../lib/news.js';
import { s as str } from '../i18n/index.js';

interface Props {
  entry: any;
  choice?: { kind: 'brand' | 'photo' | 'none'; n?: number; b?: string; pool?: any };
  w?: number; // fotoğrafın gösterim genişliği (px)
  h?: number;
  eager?: boolean;
  credit?: boolean; // fotoğrafçı adını görselin üzerinde göster
}
const { entry, choice = defaultVisual(entry), w = 400, h = 250, eager = false, credit = true } = Astro.props;
const d = entry.data;
const brandKey = choice.kind === 'brand' ? (choice.b ?? d.brand) : undefined;
const brand = brandKey ? brandOf(brandKey) : undefined;
const logoImg = brandKey ? brandLogo(brandKey) : null;
const photo = choice.kind === 'photo' ? (choice.pool ?? (choice.n === 2 ? d.photo2 : d.photo)) : undefined;
const loading = eager ? 'eager' : 'lazy';
const set = photo ? photoSet(photo, w, h) : undefined;
import { langOf } from '../i18n/index.js';
const EN = langOf(Astro.url) === 'en';
const catLabel = str(EN ? 'en' : 'tr', `cat.${d.category}.name`, catName(d.category));
---
<span class="visual">
  {brand ? (
    <span class:list={['brandcard', `b-${brandKey}`, { wordmark: !brand.path && !logoImg, 'has-img': !!logoImg }]} role="img" aria-label={EN ? `${brand.name} logo` : `${brand.name} logosu`}>
      {logoImg ? <img class="bl-img" src={url(logoImg)} alt="" width="96" height="96" loading={loading} decoding="async" /> : brand.path && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg>}
      <span class="bn" aria-hidden="true">{brand.name}</span>
    </span>
  ) : photo ? (
    <>
      <img class="thumb photo" src={set.src} srcset={set.srcset} sizes={set.sizes} alt={photo.alt || ''} lang={!EN && photo.alt ? 'en' : undefined} loading={loading} fetchpriority={eager ? 'high' : undefined} decoding={eager ? undefined : 'async'} width={w} height={h} />
      {credit && <span class="credit" aria-hidden="true">{photo.author} / {photoSource(photo).name}</span>}
    </>
  ) : (
    <span class="thumb noimg" aria-hidden="true"><span>{catLabel}</span></span>
  )}
</span>
