---
// Haber görseli: şirket logo kartı, Unsplash fotoğrafı veya illüstrasyon.
// choice verilmezse haberin kendi görseli kullanılır (bkz. defaultVisual).
import { IMAGES } from '../lib/site.js';
import { brandOf } from '../lib/brands.js';
import { defaultVisual, photoSrc, imageFor } from '../lib/news.js';

interface Props {
  entry: any;
  choice?: { kind: 'brand' | 'photo' | 'illus'; v?: number; n?: number; b?: string };
  w?: number; // fotoğrafın gösterim genişliği (px)
  h?: number;
  eager?: boolean;
  credit?: boolean; // fotoğrafçı adını görselin üzerinde göster
}
const { entry, choice = defaultVisual(entry), w = 400, h = 250, eager = false, credit = true } = Astro.props;
const d = entry.data;
const brandKey = choice.kind === 'brand' ? (choice.b ?? d.brand) : undefined;
const brand = brandKey ? brandOf(brandKey) : undefined;
const photo = choice.kind === 'photo' ? (choice.n === 2 ? d.photo2 : d.photo) : undefined;
const loading = eager ? 'eager' : 'lazy';
// Duyarlı görsel: telefonda kartlar tam genişlikte gösterilir; tarayıcı ekrana uygun boyutu seçer
// (küçük küçük resimlerde yalnızca 1x/2x yeterli)
const small = w <= 160;
const steps = small ? [] : [...new Set([360, 480, 640, w, 960, 1280, w * 2].filter((x) => x <= w * 2))].sort((a, b) => a - b);
const srcset = (p) => (small ? `${photoSrc(p, w, h)} 1x, ${photoSrc(p, w * 2, h * 2)} 2x` : steps.map((x) => `${photoSrc(p, x, Math.round((x * h) / w))} ${x}w`).join(', '));
const sizes = small ? undefined : `(max-width: 760px) calc(100vw - 32px), ${w}px`;
import { langOf } from '../i18n/index.js';
const EN = langOf(Astro.url) === 'en';
const IMG_EN = { arama: 'Chat bubble and magnifier illustration', gemini: 'Star constellation illustration', benchmark: 'Bar chart illustration', kod: 'Code editor and cursor illustration', rss: 'Crossed-out RSS icon illustration', modeller: 'Neural network illustration', gozluk: 'Smart glasses illustration', guvenlik: 'Locked shield illustration', regulasyon: 'Scales of justice illustration', pazarlama: 'Megaphone illustration', altyapi: 'Server racks illustration', girisim: 'Rocket illustration', odul: 'Trophy illustration' };
---
<span class="visual">
  {brand ? (
    <span class:list={['brandcard', `b-${brandKey}`, { wordmark: !brand.path }]} role="img" aria-label={EN ? `${brand.name} logo` : `${brand.name} logosu`}>
      {brand.path && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={brand.path} /></svg>}
      <span class="bn" aria-hidden="true">{brand.name}</span>
    </span>
  ) : photo ? (
    <>
      <img class="thumb photo" src={photoSrc(photo, w, h)} srcset={srcset(photo)} sizes={sizes} alt={photo.alt || ''} lang={!EN && photo.alt ? 'en' : undefined} loading={loading} fetchpriority={eager ? 'high' : undefined} decoding={eager ? undefined : 'async'} width={w} height={h} />
      {credit && <span class="credit" aria-hidden="true">{photo.author} / Unsplash</span>}
    </>
  ) : (
    <img class="thumb illus" src={imageFor(entry, choice.v)} alt={EN ? IMG_EN[d.image] : IMAGES[d.image]} loading={loading} width={w} height={h} />
  )}
</span>
